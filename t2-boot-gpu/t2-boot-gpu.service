[Unit]
Description=Keep the T2 Mac's boot GPU (macOS resets it at every macOS boot)
ConditionPathExists=/etc/t2-boot-gpu.conf
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/t2-boot-gpu apply
# Again at shutdown, so a change made in between doesn't stick.
ExecStop=/usr/bin/t2-boot-gpu apply

[Install]
WantedBy=multi-user.target

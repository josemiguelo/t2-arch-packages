#!/usr/bin/env python3
"""The T2 panel's Graphics tab helper: the dual-GPU MacBook Pro's boot GPU
(t2-boot-gpu), what drives the panel now, and whether the Radeon is awake,
from sysfs, as the session user (nothing here wakes the dGPU: no lspci, no
config space reads).

  status                   JSON: available, running, next, kept, dgpu {name, awake, state}
  set integrated|discrete  the boot GPU from the next boot on (pkexec t2-boot-gpu:
                           asks for the admin password)
"""

import glob
import json
import os
import shutil
import subprocess
import sys

CONF = "/etc/t2-boot-gpu.conf"


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def pci_name(vendor, device):
    """The device's name from hwdata's pci.ids, without touching the device."""
    v, d = vendor.removeprefix("0x"), device.removeprefix("0x")
    try:
        with open("/usr/share/hwdata/pci.ids", encoding="utf-8", errors="replace") as f:
            in_vendor = False
            for line in f:
                if line.startswith("#") or not line.strip():
                    continue  # comments sit inside vendors' blocks too
                if not line.startswith("\t"):
                    in_vendor = line.startswith(v + " ")
                elif in_vendor and line.startswith("\t" + d + " "):
                    name = line.split(None, 1)[1].strip()
                    return name.split("[")[-1].rstrip("]") if "[" in name else name
    except OSError:
        pass
    return "Radeon"


def gpus():
    igpu = dgpu = None
    for dev in glob.glob("/sys/bus/pci/devices/*"):
        if not read(f"{dev}/class").startswith("0x0300"):
            continue
        vendor = read(f"{dev}/vendor")
        if vendor == "0x8086":
            igpu = dev
        elif vendor == "0x1002":
            dgpu = dev
    return igpu, dgpu


def panel_on():
    """Which GPU's DRM card has the connected built-in panel."""
    for status in glob.glob("/sys/class/drm/card*-eDP-*/status"):
        if read(status) != "connected":
            continue
        # card1-eDP-1 -> card1, whose device is the GPU (the connector's own
        # device link leads to the DRM card, not the PCI device).
        card = os.path.basename(os.path.dirname(status)).split("-")[0]
        driver = os.path.basename(os.path.realpath(f"/sys/class/drm/{card}/device/driver"))
        return "integrated" if driver == "i915" else "discrete"
    return ""


def kept():
    for line in read(CONF).splitlines():
        if line.startswith("BOOT_GPU="):
            return line.split("=", 1)[1].strip()
    return ""


def status():
    igpu, dgpu = gpus()
    if not (igpu and dgpu and shutil.which("t2-boot-gpu")):
        print(json.dumps({"available": False}))
        return
    nxt = subprocess.run(["t2-boot-gpu"], capture_output=True, text=True).stdout.strip()
    print(json.dumps({
        "available": True,
        "running": panel_on(),
        "next": nxt,
        "kept": kept(),
        "dgpu": {
            "name": pci_name(read(f"{dgpu}/vendor"), read(f"{dgpu}/device")),
            "awake": read(f"{dgpu}/power/runtime_status") == "active",
            "state": read(f"{dgpu}/power_state"),
        },
    }))


def main(argv):
    cmd = argv[0] if argv else "status"
    if cmd == "status":
        status()
    elif cmd == "set" and len(argv) == 2 and argv[1] in ("integrated", "discrete"):
        sys.exit(subprocess.run(["pkexec", "/usr/bin/t2-boot-gpu", argv[1]]).returncode)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])

# t2-boot-gpu: Hyprland renders on the GPU the built-in panel is wired to,
# picked at each login (uwsm sources this before starting Hyprland; Hyprland's
# own config is read after aquamarine has picked its GPU). Left alone,
# aquamarine takes the first DRM card, the Intel iGPU, and when the gmux has the
# panel on the AMD dGPU every frame (the cursor's included) is copied across:
# the cursor lags, or shows as a black square. AQ_DRM_DEVICES names the panel's
# card only (the Thunderbolt ports are wired to the AMD card too), and stays
# unset without a connected eDP. The panel's card can still be registering
# (amdgpu, on the first boot after macOS, which leaves the boot GPU on the
# dGPU): wait up to 5 s for it. A user's own AQ_DRM_DEVICES wins.
if [ -z "${AQ_DRM_DEVICES:-}" ]; then
  t2_tries=0
  while [ "$t2_tries" -lt 50 ]; do
    for t2_status in /sys/class/drm/card*-eDP-*/status; do
      [ "$(cat "$t2_status" 2>/dev/null)" = connected ] || continue
      t2_card=${t2_status#/sys/class/drm/}
      export AQ_DRM_DEVICES="/dev/dri/${t2_card%%-*}"
      break 2
    done
    sleep 0.1
    t2_tries=$((t2_tries + 1))
  done
  unset t2_status t2_card t2_tries
fi

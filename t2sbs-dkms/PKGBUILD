# t2sbs: KaiT2en's copy of the ACPI Smart Battery driver (drivers/acpi/sbs.c)
# with fixes for T2 Macs (live charge_full/cycle_count, capacity relative to
# full, correct Full/Not charging status under a charge limit), as DKMS.
#
# Upstream: https://github.com/kaiT2en/KaiT2en-Fedora  modules/t2sbs
#
# Both drivers bind ACPI0002, so sbs is blacklisted here. sbshc stays in use.

pkgname=t2sbs-dkms
_modname=t2sbs
_modver=0.1
pkgver=0.1.r2.27fd5c9
pkgrel=2
pkgdesc="Apple T2 battery driver (fixed ACPI SBS) from KaiT2en, DKMS"
arch=('any')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-2.0-or-later')
depends=('dkms')
makedepends=('git')
_repo="${KAIT2EN_REPO:-$HOME/Repos/gh/kaiT2en/KaiT2en-Fedora}"
_commit=27fd5c963497556ffc9986779627a0d0f345fbe0
source=("kait2en::git+file://${_repo}#commit=${_commit}")
sha256sums=('SKIP')

pkgver() {
  cd kait2en
  printf '%s.r%s.%s' "$_modver" \
    "$(git rev-list --count HEAD -- modules/t2sbs)" \
    "$(git rev-parse --short=7 HEAD)"
}

package() {
  cd kait2en/modules/t2sbs
  local dst="$pkgdir/usr/src/$_modname-$_modver"
  install -Dm644 dkms.conf Makefile t2sbs.c sbshc.h -t "$dst/"
  printf '\n# t2-arch-packages: stock Omarchy kernels only\nBUILD_EXCLUSIVE_KERNEL="%s"\n' \
    "${T2_DKMS_KERNEL_REGEX:-.*-omarchy\$}" >> "$dst/dkms.conf"

  # t2sbs replaces sbs (both bind ACPI0002) on kernels that have t2sbs;
  # elsewhere sbs loads as usual. sbshc stays in use either way.
  install -dm755 "$pkgdir/usr/lib/modprobe.d"
  cat > "$pkgdir/usr/lib/modprobe.d/t2sbs.conf" <<'EOF'
# t2sbs replaces sbs on T2 Macs (both bind ACPI0002), on kernels that have t2sbs.
install sbs modinfo -k "$(uname -r)" -F filename t2sbs >/dev/null 2>&1 || /usr/bin/modprobe --ignore-install sbs $CMDLINE_OPTS
EOF
}

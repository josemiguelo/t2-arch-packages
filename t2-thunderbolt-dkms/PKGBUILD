# The kernel's thunderbolt driver from Linux 7.2.15 with KaiT2en's Apple RTD3
# patch, DKMS: on T2 Macs the idle Titan Ridge controller (or Ice Lake's
# integrated routers) can power off, as under macOS, instead of keeping its
# PCIe root ports' PHY on (which holds the CPU package out of the deep
# package C-states). Replaces the in-tree thunderbolt.ko from updates/.
#
# Patch 0001 (KaiT2en patches/runtime/thunderbolt, at 4b29a99, 2026-11-11):
# a PCI driver, thunderbolt-apple-power, takes the Titan Ridge root ports from
# pcieport and runs the macOS sequence (RTPC, then the bridge's and the port's
# _PS3; _PS0 and RTPC on the way back) once nothing is attached (no USB device,
# no tunnelled PCIe device) and the host router has been idle 1 s; system sleep
# keeps the controller on. Only ports with a Titan Ridge NHI below are touched
# (never the dGPU's 00:01.0). It also adds the PM device links t2thunderbolt
# added, so it replaces t2thunderbolt-dkms. Ice Lake (MacBookAir9,1): runtime
# PM for its routers in the software connection manager.
#
# Being tested (2026-11-16, MacBookPro16,1, the owner's exception to the
# one-month rule) with pcie_ports=compat kept: KaiT2en drops it ("the
# Thunderbolt runtime PM needs the PCIe port services"), but it costs this Mac
# its ~1 s wake (CLAUDE.md), and the port driver here binds the ports itself.
#
# The sources must match the kernel the module loads into, and linux-omarchy is
# NOT plain kernel.org 7.2.15 here: it carries Thunderbolt patches of its own
# (0601 updates, 0602/0606/0608 fixes, 0605 PCIe rescan after a tunnel; they
# change tb_service_driver's probe and add fields to shared structs), so a
# plain 7.2.15 driver doesn't even build against its headers. Those five are
# vendored here from omarchy-pkgs (pkgbuilds/linux-omarchy at 48d5518) as
# omarchy-*.patch and applied first; KaiT2en's 0001 is rebased onto them (one
# include hunk's context). CONFIG_USB4=m. BUILD_EXCLUSIVE_KERNEL keeps it to
# 7.2.x -omarchy kernels; a linux-omarchy update that changes its Thunderbolt
# patches needs them refreshed here.
#
# Patch: https://github.com/kaiT2en/KaiT2en-Fedora  patches/runtime/thunderbolt

pkgname=t2-thunderbolt-dkms
_kver=7.2.15
_modname=t2-thunderbolt
pkgver=7.2.15.r4.4b29a99
pkgrel=1
pkgdesc="thunderbolt with KaiT2en's Apple RTD3 (the idle Titan Ridge controller powered off) for T2 Macs, DKMS"
arch=('any')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-2.0-only')
depends=('dkms')
makedepends=('git')
conflicts=('t2thunderbolt-dkms')
# KAIT2EN_GIT=file:///path/to/clone builds from a local KaiT2en checkout.
_repo="${KAIT2EN_GIT:-https://github.com/kaiT2en/KaiT2en-Fedora.git}"
_commit=4b29a99a71258cf5d8cdd0d92e1b0aed21e3819c
_omarchy=(omarchy-0601-thunderbolt-updates.patch
          omarchy-0602-thunderbolt-fixes.patch
          omarchy-0605-thunderbolt-pcie-rescan-after-tunnel.patch
          omarchy-0606-thunderbolt-fixes-2.patch
          omarchy-0608-thunderbolt-fixes-3.patch)
_rtd3=0001-thunderbolt-add-Titan-Ridge-and-Ice-Lake-RTD3-on-Apple-T2-Macs.patch
source=("https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-${_kver}.tar.xz"
        "kait2en::git+${_repo}#commit=${_commit}"
        "${_omarchy[@]}" "$_rtd3")
noextract=("linux-${_kver}.tar.xz")
sha256sums=('d0f6b1d7324c937ccaeb5c4ca7084bfcf71db2edb3e2d3a31f0ad83a681809ab'
            'SKIP' SKIP SKIP SKIP SKIP SKIP SKIP)

pkgver() {
  cd kait2en
  printf '%s.r%s.%s' "$_kver" \
    "$(git rev-list --count HEAD -- patches/runtime/thunderbolt)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  rm -rf src
  mkdir src
  # Omarchy's patches also touch thunderbolt-net and the shared header: they're
  # extracted only so the patches apply; the module builds against the
  # installed linux-omarchy headers, which already have them.
  bsdtar -xf "linux-${_kver}.tar.xz" -C src --strip-components=1 \
    "linux-${_kver}/drivers/thunderbolt" \
    "linux-${_kver}/drivers/net/thunderbolt" \
    "linux-${_kver}/include/linux/thunderbolt.h"
  cd src
  local p out
  for p in "${_omarchy[@]}" "$_rtd3"; do
    out=$(patch -p1 --forward --no-backup-if-mismatch < "$srcdir/$p") || { echo "$out" >&2; return 1; }
    if grep -qi fuzz <<<"$out"; then
      echo "$p applied with fuzz:" >&2; echo "$out" >&2; return 1
    fi
  done
  # The rebased 0001 is KaiT2en's at the pin, but for one include hunk.
  diff -q <(grep -c '^+' "$srcdir/$_rtd3") <(grep -c '^+' "$srcdir/kait2en/patches/runtime/thunderbolt/$(head -1 "$srcdir/kait2en/patches/runtime/thunderbolt/series")") >/dev/null ||
    echo "note: the rebased 0001 adds a different number of lines than KaiT2en's" >&2
}

package() {
  local dst="$pkgdir/usr/src/$_modname-$_kver"
  install -dm755 "$dst"
  cp -a --no-preserve=ownership src/drivers/thunderbolt "$dst/"
  find "$dst" -name '*.orig' -delete
  cat > "$dst/dkms.conf" <<EOF2
PACKAGE_NAME="$_modname"
PACKAGE_VERSION="$_kver"
MAKE[0]="make -C \${kernel_source_dir} M=\${dkms_tree}/\${PACKAGE_NAME}/\${PACKAGE_VERSION}/build/thunderbolt modules"
CLEAN="make -C \${kernel_source_dir} M=\${dkms_tree}/\${PACKAGE_NAME}/\${PACKAGE_VERSION}/build/thunderbolt clean"
BUILT_MODULE_NAME[0]="thunderbolt"
BUILT_MODULE_LOCATION[0]="thunderbolt/"
DEST_MODULE_LOCATION[0]="/updates/dkms"
AUTOINSTALL="yes"
# t2-arch-packages: Linux 7.2 sources, for stock Omarchy 7.2.x kernels only
BUILD_EXCLUSIVE_KERNEL="^7\.2\.[0-9]+-[0-9]+-omarchy\$"
EOF2
}

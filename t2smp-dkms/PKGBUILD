# t2smp: KaiT2en CPU resume-ordering quirk for T2 Macs, as DKMS.
#
# With _OSI("Darwin") Apple firmware picks a suspend path where bringing
# secondary CPUs online in the early resume phase takes seconds per CPU. t2smp
# takes them offline before suspend preparation and restores them after the
# platform has resumed, when hotplug is fast again. Upstream submission:
# https://lore.kernel.org/all/20260812120326.155226-1-dev@deq.rocks/
#
# Upstream: https://github.com/kaiT2en/KaiT2en-Fedora  modules/t2smp
# Autoloads through MODULE_ALIAS for the T2 bridge (PCI 106b:1801).
# Tested on MacBookPro16,1 (linux-omarchy 7.2.15): the "Enabling non-boot CPUs"
# resume phase is gone; with pci=noaer pcie_ports=compat the wake takes ~1 s.

pkgname=t2smp-dkms
_modname=t2smp
_modver=0.1
pkgver=0.1.r2.27fd5c9
pkgrel=1
pkgdesc="Apple T2 CPU resume-ordering quirk (fast wake) from KaiT2en, DKMS"
arch=('any')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-2.0-only')
depends=('dkms')
makedepends=('git')
# KAIT2EN_GIT=file:///path/to/clone builds from a local KaiT2en checkout.
_repo="${KAIT2EN_GIT:-https://github.com/kaiT2en/KaiT2en-Fedora.git}"
_commit=27fd5c963497556ffc9986779627a0d0f345fbe0
source=("kait2en::git+${_repo}#commit=${_commit}")
sha256sums=('SKIP')

pkgver() {
  cd kait2en
  printf '%s.r%s.%s' "$_modver" \
    "$(git rev-list --count HEAD -- modules/t2smp)" \
    "$(git rev-parse --short=7 HEAD)"
}

package() {
  cd kait2en/modules/t2smp
  local dst="$pkgdir/usr/src/$_modname-$_modver"
  install -Dm644 dkms.conf Makefile t2smp.c -t "$dst/"
  printf '\n# t2-arch-packages: stock Omarchy kernels only\nBUILD_EXCLUSIVE_KERNEL="%s"\n' \
    "${T2_DKMS_KERNEL_REGEX:-.*-omarchy\$}" >> "$dst/dkms.conf"
}

# t2thunderbolt: KaiT2en quirk helper adding the missing PM device links
# between Thunderbolt PCIe ports and their NHI on T2 Macs, so the driver core
# resumes the NHI before the ports whose PCIe tunnels it restores.
#
# Upstream: https://github.com/kaiT2en/KaiT2en-Fedora  modules/t2thunderbolt
#
# Not a PCI driver (it finds Titan Ridge / Ice Lake NHIs via pci_get_device),
# but it carries MODULE_ALIAS entries for those NHI PCI IDs, so udev autoloads
# it next to the in-tree thunderbolt driver. Kernels without the module
# (BUILD_EXCLUSIVE excludes linux-t2) simply have no such alias.

pkgname=t2thunderbolt-dkms
_modname=t2thunderbolt
_modver=0.6
pkgver=0.6.r20.27fd5c9
pkgrel=1
pkgdesc="Apple T2 Thunderbolt PM ordering quirks (NHI before tunnelled ports) from KaiT2en, DKMS"
arch=('any')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-2.0-only')
depends=('dkms')
makedepends=('git')
_repo="${KAIT2EN_REPO:-$HOME/Repos/gh/kaiT2en/KaiT2en-Fedora}"
_commit=27fd5c963497556ffc9986779627a0d0f345fbe0
source=("kait2en::git+file://${_repo}#commit=${_commit}")
sha256sums=('SKIP')

pkgver() {
  cd kait2en
  printf '%s.r%s.%s' "$_modver" \
    "$(git rev-list --count HEAD -- modules/t2thunderbolt)" \
    "$(git rev-parse --short=7 HEAD)"
}

package() {
  cd kait2en/modules/t2thunderbolt
  local dst="$pkgdir/usr/src/$_modname-$_modver"
  install -Dm644 dkms.conf Makefile t2thunderbolt.c README.md -t "$dst/"
  printf '\n# t2-arch-packages: stock Omarchy kernels only\nBUILD_EXCLUSIVE_KERNEL="%s"\n' \
    "${T2_DKMS_KERNEL_REGEX:-.*-omarchy\$}" >> "$dst/dkms.conf"
}

# T2 SMC Control: KaiT2en's GTK app for t2smc (fans, sensors, power stats,
# battery charge limit, the SMC clock) and its battery gauging daemon.
#
# Upstream: https://github.com/kaiT2en/KaiT2en-Fedora  apps/t2-smc-control
# Authors: André Eikmeyer and 4f1sh3r. GPL-3.0-or-later with a section 7(b)
# attribution term (see LICENSING.md, shipped in /usr/share/licenses).
#
# t2-smc-gaugingd (`t2-smc-control --daemon`) is the part that matters: a
# permanent charge limit keeps the battery gauge from relearning its capacity,
# so, as powerd does on macOS, it lifts the limit for a full charge
# (t2smc's battery_charge_limit_suspended) when the gauge's DOD0 hasn't changed
# for 3 days or the last full charge is older than 21 days. The limit itself
# stays as set. Its dates live in /var/lib/t2-smc-control/gauging.
#
# Upstream installs to /usr/local with hard-coded paths; this package moves
# them to /usr. The KaiT2en wordmark is removed from the GUI header
# (no-wordmark.patch): KaiT2en's trademark terms do not allow its name or logo
# in redistributions.

pkgname=t2-smc-control
_ver=0.1.0
pkgver=0.1.0.r34.27fd5c9
pkgrel=1
pkgdesc="SMC control app and battery gauging daemon for Apple T2 Macs (KaiT2en)"
arch=('x86_64')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-3.0-or-later')
depends=('gtk4' 'libadwaita' 'polkit' 't2smc-dkms')
makedepends=('git' 'cargo')
options=('!debug')
# KAIT2EN_GIT=file:///path/to/clone builds from a local KaiT2en checkout.
_repo="${KAIT2EN_GIT:-https://github.com/kaiT2en/KaiT2en-Fedora.git}"
_commit=27fd5c963497556ffc9986779627a0d0f345fbe0
source=("kait2en::git+${_repo}#commit=${_commit}"
        'no-wordmark.patch')
sha256sums=('SKIP'
            'SKIP')

pkgver() {
  cd kait2en
  printf '%s.r%s.%s' "$_ver" \
    "$(git rev-list --count HEAD -- apps/t2-smc-control)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd kait2en
  patch -Np1 -i "$srcdir/no-wordmark.patch"
  cd apps/t2-smc-control
  sed -i 's|/usr/local/bin/|/usr/bin/|g' org.t2smccontrol.gtk.desktop systemd/t2-smc-gaugingd.service
  grep -rq '/usr/local' src org.t2smccontrol.gtk.desktop systemd &&
    { echo "unpatched /usr/local path left" >&2; return 1; }
  # Run only where t2smc drives the SMC (the app also reads macsmc, which has
  # no charge-limit suspend), and give the state file's folder to systemd.
  sed -i '/^\[Unit\]/a ConditionPathIsDirectory=/sys/module/t2smc' systemd/t2-smc-gaugingd.service
  sed -i '/^\[Service\]/a StateDirectory=t2-smc-control' systemd/t2-smc-gaugingd.service
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd kait2en/apps/t2-smc-control
  export CARGO_TARGET_DIR=target
  cargo build --release --frozen
}

check() {
  cd kait2en/apps/t2-smc-control
  export CARGO_TARGET_DIR=target
  cargo test --release --frozen
}

package() {
  cd kait2en
  local app=apps/t2-smc-control
  install -Dm755 "$app/target/release/t2-smc-control" "$pkgdir/usr/bin/t2-smc-control"
  install -Dm644 "$app/org.t2smccontrol.gtk.desktop" "$pkgdir/usr/share/applications/org.t2smccontrol.gtk.desktop"
  install -Dm644 "$app/assets/icons/hicolor/scalable/apps/org.t2smccontrol.gtk.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.t2smccontrol.gtk.svg"
  install -Dm644 "$app/systemd/t2-smc-gaugingd.service" "$pkgdir/usr/lib/systemd/system/t2-smc-gaugingd.service"

  install -Dm644 "$app/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSING.md AUTHORS -t "$pkgdir/usr/share/licenses/$pkgname/"
}

# T2 BCE stack (DMA, core, VHCI keyboard/trackpad host, audio, AVE, Sidecar)
# from KaiT2en-Fedora, packaged as DKMS for Arch/Omarchy.
#
# Upstream: https://github.com/kaiT2en/KaiT2en-Fedora
#   modules/t2bce_stack            dkms.conf + top-level Kbuild Makefile
#   modules/t2bce_{dma,core,vhci,audio}
#   t2-services/t2-ave/kernel/t2bce_{ave,sidecar}
# Mirrors copy_module_source() in scripts/fedora/install-dkms-modules.sh.
#
# Conflicts with any kernel that builds t2bce in-tree (linux-t2): both claim
# PCI 106b:1801. Meant for a stock kernel such as linux-omarchy.

pkgname=t2bce-stack-dkms
_modname=t2bce_stack
_modver=0.01
pkgver=0.01.r60.27fd5c9
pkgrel=2
pkgdesc="Apple T2 BCE driver stack (keyboard, trackpad, audio, AVE) from KaiT2en, DKMS"
arch=('any')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-2.0-only')
depends=('dkms')
makedepends=('git')
conflicts=('apple-bce-dkms' 't2bce-dkms')
# KAIT2EN_GIT=file:///path/to/clone builds from a local KaiT2en checkout.
_repo="${KAIT2EN_GIT:-https://github.com/kaiT2en/KaiT2en-Fedora.git}"
_commit=27fd5c963497556ffc9986779627a0d0f345fbe0
source=("kait2en::git+${_repo}#commit=${_commit}")
sha256sums=('SKIP')

pkgver() {
  cd kait2en
  printf '%s.r%s.%s' "$_modver" \
    "$(git rev-list --count HEAD -- modules/t2bce_* t2-services/t2-ave/kernel)" \
    "$(git rev-parse --short=7 HEAD)"
}

# KaiT2en's 6ddacd9 (2026-11-11) replaced the whole t2bce stack, keyboard
# included, with modules/apple-t2-bridge (snd_apple_t2 for audio). A pin at or
# past it has no t2bce sources: that's a port by hand (new package, initramfs
# modules, UCM, the DSP's udev match), never a re-pin.
prepare() {
  cd kait2en
  local c
  for c in t2bce_stack t2bce_dma t2bce_core t2bce_vhci t2bce_audio; do
    [[ -d modules/$c ]] || { echo "modules/$c is gone at this KaiT2en commit (apple-t2-bridge replaced the t2bce stack in 6ddacd9): port it by hand" >&2; return 1; }
  done
}

package() {
  cd kait2en
  local dst="$pkgdir/usr/src/$_modname-$_modver"
  install -dm755 "$dst"

  install -m644 modules/t2bce_stack/{dkms.conf,Makefile} "$dst/"
  # Only build for stock Omarchy kernels. linux-t2 carries its own in-tree
  # t2bce, and a DKMS copy in updates/ would silently override it.
  printf '\n# t2-arch-packages: never for linux-t2 (has t2bce in-tree)\nBUILD_EXCLUSIVE_KERNEL="%s"\n' \
    "${T2_DKMS_KERNEL_REGEX:-.*-omarchy\$}" >> "$dst/dkms.conf"

  local c src
  for c in t2bce_dma t2bce_core t2bce_vhci t2bce_audio t2bce_ave t2bce_sidecar; do
    src=modules/$c
    [[ $c == t2bce_ave || $c == t2bce_sidecar ]] && src=t2-services/t2-ave/kernel/$c
    install -dm755 "$dst/$c"
    cp -a --no-preserve=ownership "$src/." "$dst/$c/"
  done

  # Unit tests and stray build products don't belong in /usr/src.
  rm -rf "$dst"/*/tests
  find "$dst" \( -name '*.o' -o -name '*.ko' -o -name '*.mod' -o -name '*.mod.c' \
    -o -name '.*.cmd' -o -name Module.symvers -o -name modules.order \) -delete
}

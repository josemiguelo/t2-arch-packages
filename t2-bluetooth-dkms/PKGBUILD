# The kernel's Broadcom Bluetooth drivers (btbcm, hci_uart, hci_bcm4377) from
# Linux 7.2.15, with KaiT2en's Apple Broadcom fixes, DKMS. They replace the
# in-tree modules from updates/:
#
#   0002  raise ACL priority on Apple Broadcom controllers (A2DP and HID links
#         no longer starve while Wi-Fi runs on 2.4 GHz)
#   0012  clear vendor bits in LE advertising report types: stock btbcm drops
#         most of these Macs' LE advertisements ("unknown advertising packet
#         type: 0x11"), so Bluetooth LE keyboards and mice never show up or
#         can't connect (MacBookPro16,1 on linux-omarchy: 320 drops in a boot;
#         linux-t2 carries an equivalent fix)
#   0013  strict duplicate filter quirk (scans report addresses promptly)
#   0021, 0024  hci_bcm4377 resume and registration fixes (PCIe models)
#
# The sources must match the kernel the modules load into: linux-omarchy 7.2.x
# builds plain kernel.org 7.2.15 (no stable-review patch), and its own
# Bluetooth patches touch only btusb, btintel and btintel_pcie, which aren't
# replaced here. BUILD_EXCLUSIVE_KERNEL keeps it to 7.2.x -omarchy kernels: a
# 7.3 kernel keeps its stock drivers until this package moves to 7.3 sources.
#
# Patches: https://github.com/kaiT2en/KaiT2en-Fedora  patches/runtime/wireless

pkgname=t2-bluetooth-dkms
_kver=7.2.15
_modname=t2-bluetooth
pkgver=7.2.15.r20.27fd5c9
pkgrel=1
pkgdesc="Broadcom Bluetooth drivers with KaiT2en's Apple fixes (LE devices, ACL priority), DKMS"
arch=('any')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-2.0-only')
depends=('dkms')
makedepends=('git')
# KAIT2EN_GIT=file:///path/to/clone builds from a local KaiT2en checkout.
_repo="${KAIT2EN_GIT:-https://github.com/kaiT2en/KaiT2en-Fedora.git}"
_commit=27fd5c963497556ffc9986779627a0d0f345fbe0
_patches=(0002 0012 0013 0021 0024)
source=("https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-${_kver}.tar.xz"
        "kait2en::git+${_repo}#commit=${_commit}")
noextract=("linux-${_kver}.tar.xz")
sha256sums=('d0f6b1d7324c937ccaeb5c4ca7084bfcf71db2edb3e2d3a31f0ad83a681809ab'
            'SKIP')

pkgver() {
  cd kait2en
  printf '%s.r%s.%s' "$_kver" \
    "$(git rev-list --count HEAD -- patches/runtime/wireless)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  rm -rf bluetooth
  mkdir bluetooth
  bsdtar -xf "linux-${_kver}.tar.xz" -C bluetooth --strip-components=3 \
    "linux-${_kver}/drivers/bluetooth"
  cd bluetooth
  local p
  for p in "${_patches[@]}"; do
    patch -p3 --forward < "$(ls "$srcdir"/kait2en/patches/runtime/wireless/"$p"-*.patch)"
  done
}

package() {
  local dst="$pkgdir/usr/src/$_modname-$_kver"
  install -dm755 "$dst"
  cp -a --no-preserve=ownership bluetooth/. "$dst/"
  find "$dst" -name '*.orig' -delete
  cat > "$dst/dkms.conf" <<EOF
PACKAGE_NAME="$_modname"
PACKAGE_VERSION="$_kver"

# The kernel's own drivers/bluetooth Makefile builds what this kernel's config
# enables; only these three are installed, over the in-tree ones.
BUILT_MODULE_NAME[0]="btbcm"
DEST_MODULE_LOCATION[0]="/updates/dkms"
BUILT_MODULE_NAME[1]="hci_uart"
DEST_MODULE_LOCATION[1]="/updates/dkms"
BUILT_MODULE_NAME[2]="hci_bcm4377"
DEST_MODULE_LOCATION[2]="/updates/dkms"

AUTOINSTALL="yes"

# t2-arch-packages: Linux 7.2 sources, for stock Omarchy 7.2.x kernels only
BUILD_EXCLUSIVE_KERNEL="^7\\.2\\.[0-9]+-[0-9]+-omarchy\$"
EOF
}

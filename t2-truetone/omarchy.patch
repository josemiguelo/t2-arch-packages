@@ -0,0 +1,170 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Gamma LUT of the built-in panel through wlr-gamma-control (Hyprland and
+//! other wlroots-style compositors), in place of mutter's SetCrtcGamma.
+//!
+//! The compositor keeps our table only while the gamma control object lives:
+//! dropping it (or the daemon dying) gives the panel its own table back. Only
+//! one client per output gets control; a second one gets `failed`. Omarchy's
+//! night light (hyprsunset) uses the colour transform matrix instead, so both
+//! apply, one after the other.
+
+use std::io::{Seek, SeekFrom, Write};
+use std::os::fd::{AsFd, FromRawFd, OwnedFd};
+
+use anyhow::{Context, Result, anyhow, bail};
+use wayland_client::globals::{GlobalListContents, registry_queue_init};
+use wayland_client::protocol::{wl_output, wl_registry};
+use wayland_client::{Connection, Dispatch, EventQueue, Proxy, QueueHandle, delegate_noop};
+use wayland_protocols_wlr::gamma_control::v1::client::zwlr_gamma_control_manager_v1::ZwlrGammaControlManagerV1;
+use wayland_protocols_wlr::gamma_control::v1::client::zwlr_gamma_control_v1::{self, ZwlrGammaControlV1};
+
+struct Out {
+    global: u32,
+    output: wl_output::WlOutput,
+    name: Option<String>,
+}
+
+#[derive(Default)]
+struct State {
+    outputs: Vec<Out>,
+    size: Option<u32>,
+    failed: bool,
+    panel_global: Option<u32>,
+}
+
+impl Dispatch<wl_registry::WlRegistry, GlobalListContents> for State {
+    fn event(
+        state: &mut Self,
+        _: &wl_registry::WlRegistry,
+        event: wl_registry::Event,
+        _: &GlobalListContents,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        if let wl_registry::Event::GlobalRemove { name } = event {
+            if state.panel_global == Some(name) {
+                state.failed = true;
+            }
+        }
+    }
+}
+
+impl Dispatch<wl_output::WlOutput, u32> for State {
+    fn event(
+        state: &mut Self,
+        _: &wl_output::WlOutput,
+        event: wl_output::Event,
+        global: &u32,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        if let wl_output::Event::Name { name } = event {
+            if let Some(o) = state.outputs.iter_mut().find(|o| o.global == *global) {
+                o.name = Some(name);
+            }
+        }
+    }
+}
+
+impl Dispatch<ZwlrGammaControlV1, ()> for State {
+    fn event(
+        state: &mut Self,
+        _: &ZwlrGammaControlV1,
+        event: zwlr_gamma_control_v1::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        match event {
+            zwlr_gamma_control_v1::Event::GammaSize { size } => state.size = Some(size),
+            zwlr_gamma_control_v1::Event::Failed => state.failed = true,
+            _ => {}
+        }
+    }
+}
+
+delegate_noop!(State: ignore ZwlrGammaControlManagerV1);
+
+/// The built-in panel's gamma control.
+pub struct Panel {
+    conn: Connection,
+    queue: EventQueue<State>,
+    state: State,
+    control: ZwlrGammaControlV1,
+    pub connector: String,
+    pub size: usize,
+}
+
+fn builtin(name: &str) -> bool {
+    ["eDP", "LVDS", "DSI"].iter().any(|p| name.starts_with(p))
+}
+
+impl Panel {
+    pub fn open() -> Result<Self> {
+        let conn = Connection::connect_to_env().context("connecting to the Wayland compositor")?;
+        let (globals, mut queue) = registry_queue_init::<State>(&conn).context("reading Wayland globals")?;
+        let qh = queue.handle();
+        let manager: ZwlrGammaControlManagerV1 =
+            globals.bind(&qh, 1..=1, ()).context("the compositor has no wlr-gamma-control")?;
+        let mut state = State::default();
+        for g in globals.contents().clone_list() {
+            if g.interface == wl_output::WlOutput::interface().name && g.version >= 4 {
+                let output = globals.registry().bind::<wl_output::WlOutput, _, _>(g.name, 4, &qh, g.name);
+                state.outputs.push(Out { global: g.name, output, name: None });
+            }
+        }
+        queue.roundtrip(&mut state).context("Wayland roundtrip")?;
+        let (global, output, connector) = state
+            .outputs
+            .iter()
+            .find_map(|o| {
+                o.name.as_deref().filter(|n| builtin(n)).map(|n| (o.global, o.output.clone(), n.to_string()))
+            })
+            .ok_or_else(|| anyhow!("no active built-in panel"))?;
+        state.panel_global = Some(global);
+        let control = manager.get_gamma_control(&output, &qh, ());
+        queue.roundtrip(&mut state).context("Wayland roundtrip")?;
+        if state.failed {
+            bail!("{connector}: another program holds its gamma table");
+        }
+        let size = state.size.ok_or_else(|| anyhow!("{connector}: no gamma size"))? as usize;
+        if size < 2 {
+            bail!("{connector}: gamma size {size}");
+        }
+        Ok(Panel { conn, queue, state, control, connector, size })
+    }
+
+    /// Handle what the compositor sent: a lost panel or a lost control.
+    pub fn check(&mut self) -> Result<()> {
+        self.queue.roundtrip(&mut self.state).context("Wayland roundtrip")?;
+        if self.state.failed {
+            bail!("{}: gamma control lost", self.connector);
+        }
+        Ok(())
+    }
+
+    /// `lut` has `self.size` entries per channel.
+    pub fn set(&mut self, lut: &[Vec<u16>; 3]) -> Result<()> {
+        if lut.iter().any(|ch| ch.len() != self.size) {
+            bail!("gamma table of the wrong size");
+        }
+        let fd = unsafe { libc::memfd_create(c"t2-truetone-gamma".as_ptr(), libc::MFD_CLOEXEC) };
+        if fd < 0 {
+            return Err(std::io::Error::last_os_error()).context("memfd_create");
+        }
+        let mut file = std::fs::File::from(unsafe { OwnedFd::from_raw_fd(fd) });
+        let bytes: Vec<u8> = lut.iter().flatten().flat_map(|v| v.to_ne_bytes()).collect();
+        file.write_all(&bytes).context("writing the gamma table")?;
+        file.seek(SeekFrom::Start(0)).context("rewinding the gamma table")?;
+        self.control.set_gamma(file.as_fd());
+        self.conn.flush().context("Wayland flush")?;
+        Ok(())
+    }
+}
+
+impl Drop for Panel {
+    fn drop(&mut self) {
+        self.control.destroy();
+        let _ = self.conn.flush();
+    }
+}

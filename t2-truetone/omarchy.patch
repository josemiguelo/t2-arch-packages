+/// The panel's backlight: `T2_TRUETONE_BACKLIGHT` if set, else the kernel's
+/// order of preference, firmware, platform, raw. `None` when there is none.
+pub fn find() -> Result<Option<Backlight>> {
+    let root = PathBuf::from("/sys/class/backlight");
+    let wanted = std::env::var("T2_TRUETONE_BACKLIGHT").ok().filter(|v| !v.is_empty());
+    let mut found: Vec<(usize, String)> = Vec::new();
+    for entry in fs::read_dir(&root).context("reading /sys/class/backlight")? {
+        let name = entry?.file_name().to_string_lossy().into_owned();
+        if wanted.as_deref().is_some_and(|w| w != name) || (wanted.is_none() && excluded(&name)) {
+            continue;
+        }
+        let kind = fs::read_to_string(root.join(&name).join("type")).unwrap_or_default();
+        let rank = ["firmware", "platform", "raw"].iter().position(|k| *k == kind.trim()).unwrap_or(3);
+        found.push((rank, name));
+    }
+    found.sort();
+    let Some((_, name)) = found.into_iter().next() else { return Ok(None) };
+    let dir = root.join(&name);
+    let max: i32 = fs::read_to_string(dir.join("max_brightness"))
+        .with_context(|| format!("reading {name} max_brightness"))?
+        .trim()
+        .parse()
+        .with_context(|| format!("{name} max_brightness"))?;
+    if max < 1 {
+        return Err(anyhow!("{name}: max_brightness {max}"));
+    }
+    // 1 %: some panels go fully dark at 0.
+    Ok(Some(Backlight { name, dir, min: (max / 100).max(1), max }))
 }
 

-        .context("mutter SetBacklight")?;
-    Ok(())
+impl Backlight {
+    pub fn read(&self) -> Result<i32> {
+        let p = self.dir.join("brightness");
+        Ok(fs::read_to_string(&p).with_context(|| format!("reading {}", p.display()))?.trim().parse()?)
+    }
+
+    pub fn set(&self, system: &Connection, value: i32) -> Result<()> {
+        let session = Proxy::new(
+            system,
+            "org.freedesktop.login1",
+            "/org/freedesktop/login1/session/auto",
+            "org.freedesktop.login1.Session",
+        )?;
+        session
+            .call_method("SetBrightness", &("backlight", self.name.as_str(), value.max(0) as u32))
+            .context("logind SetBrightness")?;
+        Ok(())
+    }
 }

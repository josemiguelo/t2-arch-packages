  "trigger.share.airshare-files": { "icon": "", "label": "File with AirShare", "description": "To an Android phone (Quick Share) or an Apple device (AirDrop)", "aliases": ["airshare", "airdrop", "quickshare"], "when": "command -v t2-airshare", "action": "/usr/share/t2-omarchy/tabs/airshare/airshare send-files" },
  "trigger.share.airshare-clipboard": { "icon": "", "label": "Clipboard with AirShare", "when": "command -v t2-airshare", "action": "/usr/share/t2-omarchy/tabs/airshare/airshare send-clipboard" },
  "trigger.share.airshare-screenshot": { "icon": "", "label": "Last Screenshot with AirShare", "when": "command -v t2-airshare", "action": "/usr/share/t2-omarchy/tabs/airshare/airshare send-screenshot" },
  "trigger.share.airshare-visible": { "icon": "󰥦", "label": "Visible to Phones and Macs (AirShare)", "description": "Receive with Quick Share and AirDrop", "when": "command -v t2-airshare", "checked": "systemctl --user is-active --quiet t2-airshare.service", "action": "/usr/share/t2-omarchy/tabs/airshare/airshare visible toggle" },

+        Ok(listener) => listener,
+        Err(err) => {
+            warn!("TCP port {QUICK_SHARE_PORT} is busy ({err}), listening on another one: a firewall may block it");
+            TcpListener::bind(("0.0.0.0", 0)).await.context("listen")?
+        }
+    };
     let port = listener.local_addr()?.port();

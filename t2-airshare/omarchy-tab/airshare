#!/usr/bin/env python3
"""The T2 panel's AirShare tab helper: T2 AirShare's state and
actions for the Omarchy bar, where the panel has no D-Bus or TOML of its own.

  status                 JSON: installed, visible, downloadDir, trusted, recent, pending
  visible on|off|toggle  the receiver (t2-airshare.service, as the app's switch)
  untrust <name>         drop a device from trusted_devices in config.toml
  send-files             pick files (omarchy-file-select), then the tab's send view
  send-clipboard         the clipboard (text or image) as a file, then the send view
  send-screenshot        the newest screenshot, then the send view
  pending clear          leave the send view
  nearby [seconds]       the phones (Quick Share) and Apple devices (AirDrop) nearby,
                         one JSON line each as found: proto, id, name, type, addr
  send-to quickshare <addr> <files...> / send-to airdrop <id> <files...>
                         send to one, progress as JSON lines (waiting with the PIN,
                         sending, progress, sent, declined, error)
  open <path> / show <path>   open a received file / show it in the file manager

The send actions record the files as pending and open the T2 panel on this
tab, which lists the devices nearby (`t2airshare list --json` and
`t2drop list --json`, run side by side) and sends to the one picked
(`t2airshare send --addr` / `t2drop send --id`, with --json). Received files
come from the receiver's journal ("received <path>" for Quick Share,
"saved [...]" for AirDrop), the only record of them.
"""

import json
import os
import re
import shutil
import subprocess
import sys
import time
import tomllib
from pathlib import Path

UNIT = "t2-airshare.service"
APP = "t2airshare"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "t2-airshare" / "config.toml"
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "t2-airshare-tab"
RECENT = 8
PENDING = RUNTIME / "pending.json"
PENDING_TTL = 15 * 60  # pending files older than this are forgotten


def run(*cmd, check=False, capture=True):
    return subprocess.run(cmd, check=check, text=True, capture_output=capture)


def config():
    try:
        return tomllib.loads(CONFIG.read_text())
    except (FileNotFoundError, tomllib.TOMLDecodeError):
        return {}


def toml_string(value):
    # JSON's string escapes are valid TOML basic strings.
    return json.dumps(value, ensure_ascii=False)


def write_config(conf):
    lines = []
    if conf.get("download_dir"):
        lines.append(f"download_dir = {toml_string(str(conf['download_dir']))}")
    lines.append("trusted_devices = [" + ", ".join(toml_string(t) for t in conf.get("trusted_devices", [])) + "]")
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG.with_suffix(".toml.tmp")
    tmp.write_text("\n".join(lines) + "\n")
    tmp.replace(CONFIG)


def download_dir(conf):
    if conf.get("download_dir"):
        return str(conf["download_dir"])
    out = run("xdg-user-dir", "DOWNLOAD").stdout.strip()
    return out or str(Path.home())


def visible():
    return run("systemctl", "--user", "is-active", "--quiet", UNIT, capture=False).returncode == 0


def recent():
    """Files the receiver saved, newest first, those still on disk."""
    out = run("journalctl", "--user", "-u", UNIT, "-o", "json", "--since", "-30 days", "--output-fields=MESSAGE").stdout
    found = []
    for line in out.splitlines():
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            continue
        message = entry.get("MESSAGE") or ""
        if isinstance(message, list):
            continue
        when = int(entry.get("__REALTIME_TIMESTAMP", "0")) // 1_000_000
        paths = []
        quick = re.search(r"\] received (/.+)$", message)
        if quick:
            paths = [quick.group(1)]
        drop = re.search(r" saved (\[.*\])$", message)
        if drop:
            try:
                paths = json.loads(drop.group(1))
            except json.JSONDecodeError:
                paths = []
        for path in paths:
            if Path(path).name.startswith("._"):
                continue
            found.append({"path": path, "name": Path(path).name, "when": when})
    seen, result = set(), []
    for item in reversed(found):
        if item["path"] in seen or not Path(item["path"]).exists():
            continue
        seen.add(item["path"])
        result.append(item)
        if len(result) >= RECENT:
            break
    return result


def status():
    conf = config()
    print(json.dumps({
        "installed": shutil.which(APP) is not None,
        "visible": visible(),
        "downloadDir": download_dir(conf),
        "trusted": conf.get("trusted_devices", []),
        "recent": recent(),
        "pending": pending_batch()[0],
        "pendingAt": pending_batch()[1],
    }, ensure_ascii=False))


def pending_batch():
    """The pending files and their batch stamp (when they were picked)."""
    try:
        p = json.loads(PENDING.read_text())
    except (OSError, ValueError):
        return [], 0
    if time.time() - p.get("at", 0) > PENDING_TTL:
        return [], 0
    return [f for f in p.get("files", []) if os.path.exists(f)], p.get("at", 0)


def pending():
    return pending_batch()[0]


def clear_pending(at=None):
    """Forgets the pending files; with `at`, only if they're still that batch
    (files picked meanwhile stay)."""
    if at is not None:
        try:
            if json.loads(PENDING.read_text()).get("at") != at:
                return
        except (OSError, ValueError):
            return
    PENDING.unlink(missing_ok=True)


def set_visible(arg):
    on = {"on": True, "off": False, "toggle": not visible()}[arg]
    run("systemctl", "--user", "enable" if on else "disable", "--now", UNIT, capture=False)


def untrust(name):
    conf = config()
    conf["trusted_devices"] = [t for t in conf.get("trusted_devices", []) if t != name]
    write_config(conf)


def send(paths):
    """Records the files as pending and opens the T2 panel on this tab."""
    if not paths:
        return
    RUNTIME.mkdir(parents=True, exist_ok=True)
    tmp = PENDING.with_suffix(".tmp")
    tmp.write_text(json.dumps({"files": [os.path.abspath(p) for p in paths], "at": time.time()}))
    tmp.replace(PENDING)
    # Closed first: opening runs the tab's refresh, which finds the files.
    run("omarchy-shell", "-q", "t2.panel", "close")
    run("omarchy-shell", "-q", "t2.panel", "tab", "airshare")


def nearby(seconds):
    """Both discoveries side by side, their JSON lines passed on as they come."""
    import selectors
    import signal
    # Quick Share finds phones over Bluetooth LE; bounded, bluetoothd may be down.
    try:
        subprocess.run(["bluetoothctl", "power", "on"], capture_output=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        pass
    procs = []
    for cmd in (["t2airshare", "list", "--json", "--wait", str(seconds)],
                ["t2drop", "list", "--json", "--wait", str(seconds)]):
        if shutil.which(cmd[0]):
            procs.append(subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL))

    def stop(*_):
        for p in procs:
            p.terminate()
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    # Raw reads, split into lines here: a buffered readline() could keep a
    # second line waiting until the next one, or the end, arrived.
    sel = selectors.DefaultSelector()
    pending = {}
    for p in procs:
        sel.register(p.stdout.fileno(), selectors.EVENT_READ)
        pending[p.stdout.fileno()] = b""
    while pending:
        for key, _ in sel.select():
            fd = key.fd
            chunk = os.read(fd, 65536)
            if not chunk:
                sel.unregister(fd)
                del pending[fd]
                continue
            buf = pending[fd] + chunk
            *lines, pending[fd] = buf.split(b"\n")
            for line in lines:
                if line.startswith(b"{"):
                    print(line.decode(errors="replace"), flush=True)
    for p in procs:
        p.wait()


def send_to(proto, target, files):
    if proto == "quickshare":
        cmd = ["t2airshare", "send", "--addr", target, "--json", *files]
    elif proto == "airdrop":
        cmd = ["t2drop", "send", "--id", target, "--json", *files]
    else:
        raise SystemExit(f"unknown protocol {proto!r}")
    os.execvp(cmd[0], cmd)


def send_files():
    picked = run("omarchy-file-select", "--multiple", "--title", "Send with AirShare")
    if picked.returncode == 0:
        send([p for p in picked.stdout.splitlines() if p])


def send_clipboard():
    types = run("wl-paste", "--list-types").stdout.split()
    if not types:
        notify("The clipboard is empty")
        return
    RUNTIME.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y-%m-%d_%H-%M-%S")
    image = next((t for t in types if t.startswith("image/")), None)
    if image:
        target = RUNTIME / f"clipboard-{stamp}.{image.split('/')[1].split('+')[0]}"
        data = subprocess.run(["wl-paste", "--type", image], capture_output=True).stdout
        target.write_bytes(data)
    else:
        target = RUNTIME / f"clipboard-{stamp}.txt"
        target.write_text(run("wl-paste", "--no-newline").stdout)
    send([str(target)])


def screenshot_dir():
    if os.environ.get("OMARCHY_SCREENSHOT_DIR"):
        return Path(os.environ["OMARCHY_SCREENSHOT_DIR"])
    pictures = run("xdg-user-dir", "PICTURES").stdout.strip() or str(Path.home() / "Pictures")
    return Path(pictures) / "Screenshots"


def send_screenshot():
    files = [p for p in screenshot_dir().glob("*") if p.is_file()]
    if not files:
        notify(f"No screenshots in {screenshot_dir()}")
        return
    send([str(max(files, key=lambda p: p.stat().st_mtime))])


def notify(text):
    run("notify-send", "-a", "AirShare", "AirShare", text, capture=False)


def open_file(path):
    subprocess.Popen(["xdg-open", path], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def show_file(path):
    uri = Path(path).absolute().as_uri()
    run("busctl", "--user", "call", "org.freedesktop.FileManager1", "/org/freedesktop/FileManager1",
        "org.freedesktop.FileManager1", "ShowItems", "ass", "1", uri, "", capture=False)


def main(argv):
    if not argv:
        print(__doc__, file=sys.stderr)
        return 2
    cmd, args = argv[0], argv[1:]
    if cmd == "status":
        status()
    elif cmd == "visible" and args and args[0] in ("on", "off", "toggle"):
        set_visible(args[0])
    elif cmd == "untrust" and args:
        untrust(args[0])
    elif cmd == "send-files":
        send_files()
    elif cmd == "send-clipboard":
        send_clipboard()
    elif cmd == "send-screenshot":
        send_screenshot()
    elif cmd == "pending" and args[:1] == ["clear"]:
        clear_pending(float(args[1]) if len(args) > 1 else None)
    elif cmd == "nearby":
        nearby(int(args[0]) if args and args[0].isdigit() else 30)
    elif cmd == "send-to" and len(args) >= 3:
        send_to(args[0], args[1], args[2:])
    elif cmd == "open" and args:
        open_file(args[0])
    elif cmd == "show" and args:
        show_file(args[0])
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

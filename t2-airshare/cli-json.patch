+/// A JSON string literal (the few lines --json prints need no JSON library).
+fn json_str(value: &str) -> String {
+    let mut out = String::from("\"");
+    for c in value.chars() {
+        match c {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            c if (c as u32) < 0x20 => out.push_str(&format!("\\u{:04x}", c as u32)),
+            c => out.push(c),
+        }
+    }
+    out.push('"');
+    out
+}
+
+/// Prints each phone as discovery finds it, for `wait` seconds.
+async fn list_peers(wait: u64, json: bool) -> Result<()> {
+    let mut discovery = Discovery::start().await?;
+    let deadline = tokio::time::Instant::now() + Duration::from_secs(wait);
+    loop {
+        tokio::select! {
+            peer = discovery.next() => {
+                let peer = peer?;
+                if json {
+                    println!(
+                        "{{\"proto\":\"quickshare\",\"id\":{},\"name\":{},\"type\":{},\"addr\":{}}}",
+                        json_str(&peer.endpoint_id),
+                        json_str(&peer.label()),
+                        json_str(&format!("{:?}", peer.device_type)),
+                        json_str(&peer.addr.to_string()),
+                    );
+                } else {
+                    println!("{} ({:?}) {}", peer.label(), peer.device_type, peer.addr);
+                }
+                let _ = std::io::stdout().flush();
+            }
+            _ = tokio::time::sleep_until(deadline) => return Ok(()),
+        }
+    }
+}
+
+/// Sends to a phone already found (`list`), by its address.
+async fn send_to(addr: SocketAddr, name: &str, files: &[PathBuf], json: bool) -> Result<()> {
+    if !json {
+        println!("sending to {addr}");
+        let mut progress = CliProgress { last: 0 };
+        match send::send(addr, name, files, &mut progress).await? {
+            SendOutcome::Sent => println!("\rsent {} file(s)          ", files.len()),
+            SendOutcome::Declined(status) => println!("\rdeclined by the phone ({status})"),
+        }
+        return Ok(());
+    }
+    let mut progress = JsonProgress { last: u64::MAX };
+    match send::send(addr, name, files, &mut progress).await {
+        Ok(SendOutcome::Sent) => println!("{{\"event\":\"sent\",\"files\":{}}}", files.len()),
+        Ok(SendOutcome::Declined(status)) => {
+            println!("{{\"event\":\"declined\",\"status\":{}}}", json_str(&status))
+        }
+        Err(error) => {
+            println!("{{\"event\":\"error\",\"message\":{}}}", json_str(&format!("{error:#}")));
+            return Err(error);
+        }
+    }
+    Ok(())
+}
+
+struct JsonProgress {
+    last: u64,
+}
+
+impl Progress for JsonProgress {
+    fn waiting(&mut self, pin: &str) {
+        println!("{{\"event\":\"waiting\",\"pin\":{}}}", json_str(pin));
+        let _ = std::io::stdout().flush();
+    }
+
+    fn sent(&mut self, sent: u64, total: u64) {
+        let percent = sent * 100 / total.max(1);
+        if percent != self.last {
+            self.last = percent;
+            println!("{{\"event\":\"progress\",\"sent\":{sent},\"total\":{total},\"percent\":{percent}}}");
+            let _ = std::io::stdout().flush();
+        }
+    }
+}

#!/usr/bin/env python3
"""The T2 panel's Sidecar tab helper: t2-sidecar's state and
actions for the Omarchy bar.

  status             JSON: installed, running, mode, size, encoder, t2Ave, client
  on | off           start (the mode used last) / stop streaming
  mode extend|mirror the mode; restarts the stream when it's running
  size WxH           the extended display's size; restarts it when extended
  pair               Sunshine's PIN page, to pair Moonlight on a new device

t2-sidecar keeps the mode and size in ~/.local/state/t2-sidecar and the running
one in $XDG_RUNTIME_DIR/t2-sidecar/mode. Whether a device is watching comes
from Sunshine's "CLIENT CONNECTED"/"CLIENT DISCONNECTED" lines in the unit's
journal since it last started.
"""

import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

UNIT = "t2-sidecar.service"
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")) / "t2-sidecar"
RUN = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "t2-sidecar" / "mode"
SIZES = ["1280x800", "1920x1080", "2560x1600"]
PIN_URL = "https://127.0.0.1:47990/pin"  # Sunshine listens on IPv4 only


def run(*cmd):
    return subprocess.run(cmd, text=True, capture_output=True)


def read(path, default=""):
    try:
        return path.read_text().strip()
    except OSError:
        return default


def running_mode():
    vals = dict(l.split("=", 1) for l in read(RUN).splitlines() if "=" in l)
    return vals.get("MODE", ""), vals.get("SIZE", "")


def client_connected():
    inv = run("systemctl", "--user", "show", "-p", "InvocationID", "--value", UNIT).stdout.strip()
    if not inv:
        return False
    log = run("journalctl", "--user", f"_SYSTEMD_INVOCATION_ID={inv}", "-o", "cat", "--no-pager",
              "-g", "CLIENT (DIS)?CONNECTED").stdout
    last = [l for l in log.splitlines() if "CLIENT" in l]
    return bool(last) and "DISCONNECTED" not in last[-1]


def status():
    installed = shutil.which("t2-sidecar") is not None
    active = installed and run("systemctl", "--user", "-q", "is-active", UNIT).returncode == 0
    mode, size = running_mode() if active else ("", "")
    mode = mode or read(STATE / "mode", "extend")
    size = (size or read(STATE / "size", "1920x1080@60")).split("@")[0]
    print(json.dumps({
        "installed": installed,
        "running": active,
        "mode": mode,
        "size": size,
        "sizes": SIZES if size in SIZES else SIZES + [size],
        "encoder": Path("/dev/video3").exists(),
        "t2Ave": run("systemctl", "-q", "is-active", "t2-ave.service").returncode == 0,
        "client": active and client_connected(),
    }))


def t2_sidecar(*args):
    sys.exit(run("t2-sidecar", *args).returncode)


def is_running():
    return run("systemctl", "--user", "-q", "is-active", UNIT).returncode == 0


def main(argv):
    cmd = argv[0] if argv else "status"
    if cmd == "status":
        status()
    elif cmd == "on":
        t2_sidecar("start")
    elif cmd == "off":
        t2_sidecar("off")
    elif cmd == "mode" and len(argv) == 2 and argv[1] in ("extend", "mirror"):
        STATE.mkdir(parents=True, exist_ok=True)
        (STATE / "mode").write_text(argv[1] + "\n")
        if is_running():
            t2_sidecar("on" if argv[1] == "extend" else "mirror")
    elif cmd == "size" and len(argv) == 2 and re.fullmatch(r"\d+x\d+", argv[1]):
        STATE.mkdir(parents=True, exist_ok=True)
        (STATE / "size").write_text(argv[1] + "@60\n")
        if is_running() and running_mode()[0] == "extend":
            t2_sidecar("on", argv[1])
    elif cmd == "pair":
        launcher = shutil.which("omarchy-launch-webapp")
        args = [launcher, PIN_URL, "--ignore-certificate-errors"] if launcher else ["xdg-open", PIN_URL]
        subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])

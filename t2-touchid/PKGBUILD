# T2 Touch ID: KaiT2en's t2-touchid daemon, which bridges the T2's Touch ID
# sensor to stock fprintd. The T2's Secure Enclave matches the finger (fingers
# are enrolled in macOS only); the daemon reaches its BiometricKit service over
# the T2's internal USB network link (BridgeXPC, IPv6 link-local) and hands the
# verdict to fprintd through libfprint's virtual storage driver.
#
# Upstream: https://github.com/kaiT2en/KaiT2en-Fedora  t2-services/t2-touchid
# (+ t2-services/shared/protocols/t2-bridgexpc). Authors: André Eikmeyer and
# contributors. GPL-3.0-or-later with a section 7(b) attribution term (see
# LICENSING.md, shipped in /usr/share/licenses).
#
# Changes from upstream:
# - Neutral file names (KaiT2en's trademark terms do not allow its name in
#   redistributions): t2-touchid.service, /etc/t2-touchid.conf, the fprintd
#   drop-in t2-touchid.conf, and the D-Bus name it signals the Touch Bar's
#   unlock prompt on, t2.TouchId at /t2/TouchId (t2-touchbar listens to it;
#   upstream's org.kait2en.TouchId; io.github.josemiguelo.T2TouchId before -6).
# - resume-reopen.patch: an attempt waiting when the machine went to sleep
#   (the lock screen's, locked just before suspend) no longer reports an error
#   to fprintd after resume; the daemon reopens its session and serves the
#   prompt standing then, so the lock screen takes a finger without a click.
# - A udev rule brings the T2 link up as it appears (as KaiT2en's does): the T2
#   signals carrier once, when its NCM function is set up, so a link opened
#   later stays NO-CARRIER. It also keeps NetworkManager off it.
# - No SELinux policy, no authselect: PAM is Omarchy's (its fingerprint setup's
#   sudo/polkit lines, omarchy-apply-lock for the lock screen).
# - reader-status.patch and /usr/share/omarchy-platform/fingerprint-readers:
#   Omarchy's fingerprint detection (omarchy-hw-fingerprint: the setup menu
#   entry and its first-run invitation) finds a reader that isn't USB through
#   that file, a path and the value it reads once the reader is usable. The
#   daemon writes /run/t2-touchid/reader: `ready` once the sensor answers and
#   macOS has fingers enrolled, else the reason. It's read as the session user,
#   so the runtime directory is 0755 (the socket in it stays root's).
# - t2-touchid-notify (ours, pkgrel 4): when that file says `no-fingers` (the T2
#   lost power, and its Secure Enclave keeps the macOS fingerprints locked until
#   a macOS login), a desktop notification says so, once per locked spell; the
#   lock screen and sudo only fail the finger and fall back to the password.
#   A user path unit on the file (inotify on its directory: hence 0755, not
#   0711) and a run at login, both enabled for every user.
#
# Turning it on is Omarchy's fingerprint setup, with the daemon running
# (enabled at install, as KaiT2en's installer does): its enroll step binds the
# macOS finger to the account with one touch, then verify, then PAM; its
# removal deletes the binding and drops fprintd and libfprint-git. T2_TOUCHID_BIND_USER in /etc/t2-touchid.conf
# binds without a touch instead, at every daemon start (so a removal comes
# back); default none. The fprintd drop-in Requires= the daemon, so a stopped
# daemon means no reader and PAM falls to the password.

pkgname=t2-touchid
_ver=0.1.0
pkgver=0.1.0.r14.c9e24f7
pkgrel=7
pkgdesc="Touch ID on Apple T2 Macs through fprintd (KaiT2en's t2-touchid)"
arch=('x86_64')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-3.0-or-later')
# fprintd and libfprint-git are Omarchy's fingerprint setup's to install (in
# one transaction, so Arch's libfprint, which conflicts, stays out) and its
# removal's to drop: as dependencies they'd stop that removal. The daemon runs
# without them, keeping its session and the reader status.
depends=('libinput' 'iproute2' 'systemd' 't2bce-stack-dkms')
optdepends=('fprintd: the fingerprint service PAM asks (Omarchy fingerprint setup installs it)'
            'libfprint-git: libfprint with its virtual storage driver (Omarchy fingerprint setup installs it)')
makedepends=('git' 'cargo')
backup=('etc/t2-touchid.conf')
# The D-Bus name changed with -6 (t2.TouchId): an older t2-touchbar listens on
# the old one, and its unlock prompt would never show.
conflicts=('t2-touchbar<0.1.0.r39.c9e24f7-3')
options=('!debug')
# KAIT2EN_GIT=file:///path/to/clone builds from a local KaiT2en checkout.
_repo="${KAIT2EN_GIT:-https://github.com/kaiT2en/KaiT2en-Fedora.git}"
_commit=c9e24f78fb455461c03f28d19b1f9ca81b55da65
source=("kait2en::git+${_repo}#commit=${_commit}"
        'resume-reopen.patch'
        'reader-status.patch'
        't2-touchid-notify')
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

pkgver() {
  cd kait2en
  printf '%s.r%s.%s' "$_ver" \
    "$(git rev-list --count HEAD -- t2-services/t2-touchid t2-services/shared/protocols/t2-bridgexpc)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd kait2en
  patch -Np1 --no-backup-if-mismatch -i "$srcdir/resume-reopen.patch"
  patch -Np1 --no-backup-if-mismatch -i "$srcdir/reader-status.patch"
  sed -i -e 's|org\.kait2en\.TouchId|t2.TouchId|g' \
    -e 's|/org/kait2en/TouchId|/t2/TouchId|g' \
    t2-services/t2-touchid/daemon/signal.rs
  grep -q '"t2.TouchId"' t2-services/t2-touchid/daemon/signal.rs ||
    { echo "D-Bus name not renamed" >&2; return 1; }
  cd t2-services/t2-touchid
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd kait2en/t2-services/t2-touchid
  export CARGO_TARGET_DIR=target
  cargo build --release --frozen
}

package() {
  cd kait2en
  local app=t2-services/t2-touchid
  install -Dm755 "$app/target/release/t2-touchid" "$pkgdir/usr/bin/t2-touchid"

  # Says why the finger fails while the Secure Enclave is locked (see the top).
  install -Dm755 "$srcdir/t2-touchid-notify" "$pkgdir/usr/lib/t2-touchid/t2-touchid-notify"
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/t2-touchid-notify.service" <<'EOF'
[Unit]
Description=Tell the user when Touch ID is locked (a macOS login unlocks it)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/lib/t2-touchid/t2-touchid-notify

[Install]
WantedBy=graphical-session.target
EOF
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/t2-touchid-notify.path" <<'EOF'
[Unit]
Description=Watch Touch ID's reader state
PartOf=graphical-session.target

[Path]
PathChanged=/run/t2-touchid/reader
Unit=t2-touchid-notify.service

[Install]
WantedBy=graphical-session.target
EOF
  install -dm755 "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
  ln -s ../t2-touchid-notify.service "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/t2-touchid-notify.service"
  ln -s ../t2-touchid-notify.path "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/t2-touchid-notify.path"

  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/t2-touchid.service" <<'EOF'
[Unit]
Description=T2 Touch ID bridge for fprintd
# No start condition: a skipped unit satisfies fprintd's Requires=, and fprintd
# would then wait on a reader nobody answers. Running without the T2 link, the
# daemon tells fprintd the sensor is unreachable after its 15 s grace.

[Service]
Type=simple
EnvironmentFile=/etc/t2-touchid.conf
ExecStart=/usr/bin/t2-touchid --socket ${T2_TOUCHID_SOCKET} --uid ${T2_TOUCHID_UID} --flags ${T2_TOUCHID_FLAGS} --bind-user ${T2_TOUCHID_BIND_USER}
Restart=on-failure
RestartSec=5
RuntimeDirectory=t2-touchid
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# A stopped daemon is no reader: the directory outlives it (Preserve).
ExecStopPost=/usr/bin/rm -f /run/t2-touchid/reader

[Install]
WantedBy=multi-user.target
EOF

  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/fprintd.service.d/t2-touchid.conf" <<'EOF'
# Points fprintd at libfprint's virtual storage device, which t2-touchid drives
# with the T2 sensor's verdicts. Tied to the daemon, so a stopped daemon means
# no reader and PAM falls straight through to the password.
[Unit]
Requires=t2-touchid.service
After=t2-touchid.service

[Service]
Environment=FP_VIRTUAL_DEVICE_STORAGE=/run/t2-touchid/fprint.sock
ReadWritePaths=/run/t2-touchid
RuntimeDirectory=t2-touchid
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
EOF

  install -Dm644 /dev/stdin "$pkgdir/usr/lib/udev/rules.d/90-t2-touchid-link.rules" <<'EOF'
# The T2's internal USB network link (Apple T2 Controller, 05ac:8233), which
# t2-touchid reaches the Touch ID sensor over: NetworkManager leaves it alone
# (no DHCP server on the T2), and it comes up with an IPv6 link-local address
# as it appears. The T2 signals carrier once, when the link is set up, so a
# link opened later stays NO-CARRIER. NM_UNMANAGED on every event, not only
# "add": a later "change" (a udevadm trigger) would otherwise drop it, and
# NetworkManager would retry DHCP on the link every 45 s.
SUBSYSTEM=="net", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="8233", ENV{NM_UNMANAGED}="1"
ACTION=="add", SUBSYSTEM=="net", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="8233", RUN+="/usr/bin/ip link set dev $name addrgenmode eui64", RUN+="/usr/bin/ip link set dev $name up"
EOF

  install -Dm644 /dev/stdin "$pkgdir/usr/share/omarchy-platform/fingerprint-readers" <<'EOF'
# T2 Touch ID (t2-touchid): the daemon writes this once the sensor answers and
# macOS has fingers enrolled. Read by omarchy-hw-fingerprint as the session user.
/run/t2-touchid/reader ready
EOF

  sed 's|org\.kait2en\.TouchId|t2.TouchId|g' "$app/integration/dbus/org.kait2en.TouchId.conf" |
    install -Dm644 /dev/stdin "$pkgdir/usr/share/dbus-1/system.d/t2.TouchId.conf"

  install -Dm644 /dev/stdin "$pkgdir/etc/t2-touchid.conf" <<'EOF'
# t2-touchid (t2-touchid.service). Restart it after a change.

# The macOS user id whose enrolled fingers this machine verifies against.
# "auto" finds the one (501 and up) that has a finger enrolled.
T2_TOUCHID_UID=auto

# Plain verify; other bits need credentials that exist only on macOS.
T2_TOUCHID_FLAGS=0

# Linux account the macOS-enrolled fingers are bound to, without a touch.
# "none" leaves binding to a manual fprintd-enroll.
T2_TOUCHID_BIND_USER=none

T2_TOUCHID_SOCKET=/run/t2-touchid/fprint.sock
EOF

  install -Dm644 "$app/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSING.md AUTHORS -t "$pkgdir/usr/share/licenses/$pkgname/"
}

+/// The reader's state for Omarchy's fingerprint detection
+/// (/usr/share/omarchy-platform/fingerprint-readers names this file with
+/// `ready`): read as the session user, so world-readable in a traversable
+/// directory. `ready` once the sensor answers and macOS has fingers enrolled;
+/// otherwise the reason (`starting`, `unreachable`, `no-fingers`).
+const READER_STATUS: &str = "/run/t2-touchid/reader";
+
+fn reader_status(state: &str) {
+    use std::os::unix::fs::PermissionsExt;
+    let temporary = format!("{READER_STATUS}.new");
+    let written = std::fs::write(&temporary, format!("{state}\n"))
+        .and_then(|()| std::fs::set_permissions(&temporary, std::fs::Permissions::from_mode(0o644)))
+        .and_then(|()| std::fs::rename(&temporary, READER_STATUS));
+    if let Err(error) = written {
+        log(&format!("cannot write {READER_STATUS}: {error}"));
+    }
+}
+
 fn log(message: &str) {
     eprintln!("t2-touchid: {message}");
 }

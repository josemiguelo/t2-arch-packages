# T2 Fan Control: KaiT2en's fan daemon + GTK app, driving fans through t2smc's
# hwmon interface. Replaces t2fanrd (which needs applesmc).
#
# Upstream: https://github.com/kaiT2en/KaiT2en-Fedora  apps/t2-fan-control
# Authors: André Eikmeyer and 4f1sh3r. GPL-3.0-or-later with a section 7(b)
# attribution term (see LICENSING.md, shipped in /usr/share/licenses).
#
# Upstream installs to /usr/local with hard-coded paths; this package moves
# them to /usr. The daemon runs as `t2-fancontrol-gtk --daemon` and falls back
# to built-in defaults (automatic control, 3-point curve) without a config at
# /etc/t2-fancontrol/config.txt.

pkgname=t2-fan-control
_ver=0.1.0
pkgver=0.1.0.r24.27fd5c9
pkgrel=3
pkgdesc="Fan control daemon and GTK app for Apple T2 Macs (KaiT2en)"
arch=('x86_64')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-3.0-or-later')
depends=('gtk4' 'libadwaita' 't2smc-dkms')
makedepends=('git' 'cargo')
# No conflicts=(t2fanrd): both can coexist on a dual-kernel system, since the
# unit only starts where t2smc is loaded. Drop t2fanrd once linux-t2 is gone.
backup=('etc/t2-fancontrol/config.txt')
_repo="${KAIT2EN_REPO:-$HOME/Repos/gh/kaiT2en/KaiT2en-Fedora}"
_commit=27fd5c963497556ffc9986779627a0d0f345fbe0
source=("kait2en::git+file://${_repo}#commit=${_commit}")
sha256sums=('SKIP')

pkgver() {
  cd kait2en
  printf '%s.r%s.%s' "$_ver" \
    "$(git rev-list --count HEAD -- apps/t2-fan-control)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd kait2en/apps/t2-fan-control
  sed -i 's|/usr/local/share/kait2en/|/usr/share/kait2en/|g' src/main.rs
  sed -i 's|/usr/local/bin/|/usr/bin/|g' org.t2fancontrol.gtk.desktop systemd/t2-fancontrol.service
  grep -rq '/usr/local' src org.t2fancontrol.gtk.desktop systemd &&
    { echo "unpatched /usr/local path left" >&2; return 1; }
  # Run only where t2smc drives the SMC. The daemon can also drive applesmc,
  # and on a linux-t2 boot it would fight t2fanrd for the fans.
  sed -i '/^\[Unit\]/a ConditionPathIsDirectory=/sys/module/t2smc' systemd/t2-fancontrol.service
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd kait2en/apps/t2-fan-control
  export CARGO_TARGET_DIR=target
  cargo build --release --frozen
}

package() {
  cd kait2en
  local app=apps/t2-fan-control
  install -Dm755 "$app/target/release/t2-fancontrol-gtk" "$pkgdir/usr/bin/t2-fancontrol-gtk"
  install -Dm644 "$app/org.t2fancontrol.gtk.desktop" "$pkgdir/usr/share/applications/org.t2fancontrol.gtk.desktop"
  install -Dm644 "$app/assets/icons/hicolor/scalable/apps/org.t2fancontrol.gtk.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.t2fancontrol.gtk.svg"
  install -Dm644 "$app/systemd/t2-fancontrol.service" "$pkgdir/usr/lib/systemd/system/t2-fancontrol.service"
  # Default config. Upstream's built-in system chill target (45 C, the average
  # of system + GPU sensors) pins a MacBookPro16,1 at 100% permanently: with a
  # dGPU that average sits at 55-60 C even with fans at max. 80 C keeps the
  # forced-cooling safety net and lets the curve run (tested 2026-11-08 on
  # MacBookPro16,1: ~2.6k rpm at ~70 C). The GUI saves its changes here, and
  # backup= keeps them across upgrades.
  install -Dm644 /dev/stdin "$pkgdir/etc/t2-fancontrol/config.txt" <<'EOF'
config_version=2
automatic_control_enabled=true
autostart_enabled=false
system_temp_target_c=80
system_cooling_time_s=5
any_sensor_enabled=false
any_sensor_temp_c=100
curve_sensor_key=
custom_curve=0:10,70:25,95:65
EOF

  # The GTK window aborts without the wordmark.
  install -Dm644 website/static/img/kait2en-wordmark.png "$pkgdir/usr/share/kait2en/kait2en-wordmark.png"

  install -Dm644 "$app/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSING.md AUTHORS -t "$pkgdir/usr/share/licenses/$pkgname/"
}

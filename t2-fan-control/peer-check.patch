+/// Whether a request may come from this connection. Reading the state is open
+/// to every local user (the socket is 0666); changing anything, which the
+/// daemon carries out as root (fan speeds, its own unit's enablement), only
+/// from root or the active local session's user, as t2-force-click does.
+/// (t2-arch-packages: the upstream daemon checked no one.)
+pub fn may_change(stream: &UnixStream) -> bool {
+    match peer_uid(stream) {
+        Some(0) => true,
+        Some(uid) => active_session_uids().contains(&uid),
+        None => false,
+    }
+}
+
+fn peer_uid(stream: &UnixStream) -> Option<u32> {
+    let mut credentials = libc::ucred { pid: 0, uid: 0, gid: 0 };
+    let mut length = std::mem::size_of::<libc::ucred>() as libc::socklen_t;
+    // SAFETY: `credentials` and `length` point to initialized writable
+    // storage of exactly the type and length SO_PEERCRED asks for.
+    let result = unsafe {
+        libc::getsockopt(
+            stream.as_raw_fd(),
+            libc::SOL_SOCKET,
+            libc::SO_PEERCRED,
+            (&mut credentials as *mut libc::ucred).cast(),
+            &mut length,
+        )
+    };
+    (result == 0 && length == std::mem::size_of::<libc::ucred>() as libc::socklen_t).then_some(credentials.uid)
+}
+
+/// The uids of logind's active sessions.
+fn active_session_uids() -> Vec<u32> {
+    let value = |session: &str, property: &str| {
+        Command::new("loginctl")
+            .args(["show-session", session, "--property", property, "--value"])
+            .output()
+            .ok()
+            .filter(|output| output.status.success())
+            .map(|output| String::from_utf8_lossy(&output.stdout).trim().to_owned())
+    };
+    let Ok(sessions) = Command::new("loginctl").args(["list-sessions", "--no-legend", "--no-pager"]).output() else {
+        return Vec::new();
+    };
+    String::from_utf8_lossy(&sessions.stdout)
+        .lines()
+        .filter_map(|line| line.split_whitespace().next().map(str::to_owned))
+        .filter(|id| value(id, "Active").as_deref() == Some("yes"))
+        .filter_map(|id| value(&id, "User")?.parse().ok())
+        .collect()
+}
+
 fn protocol_error(message: String) -> FanControlError {
     FanControlError::Protocol(message)
 }

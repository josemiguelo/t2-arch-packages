+/// The application root BlueZ reads the monitors from (an ObjectManager), and
+/// the one monitor under it.
+const MONITOR_ROOT: &str = "/org/t2drop/monitor";
+const MONITOR_PATH: &str = "/org/t2drop/monitor/apple";
+
+/// A passive advertisement monitor for Apple manufacturer data (0x004C, any
+/// element: the AirDrop one need not come first). While one is registered
+/// the kernel keeps a passive scan running, its background scan, instead of
+/// the active discovery the scanner used before: discovery listened 30 ms out
+/// of every 300 and restarted every ~10 s, so bonded LE devices (mice,
+/// keyboards) hardly ever got their directed reconnect advertisements heard
+/// and stayed disconnected after waking. BlueZ creates and updates the
+/// devices the monitor matches, so the scanner sees them as before.
+struct AppleMonitor {
+    senders: Senders,
+}
+
+#[interface(name = "org.bluez.AdvertisementMonitor1")]
+impl AppleMonitor {
+    fn release(&self) {
+        debug!("Bluetooth advertisement monitor released");
+    }
+
+    fn activate(&self) {
+        debug!("Bluetooth advertisement monitor active");
+    }
+
+    /// A matching device advertises again: BlueZ only reports changed
+    /// properties, so this keeps a known sender's time current.
+    fn device_found(&self, device: OwnedObjectPath) {
+        if let Some(sender) = self.senders.lock().unwrap().get_mut(&device) {
+            sender.last = Instant::now();
+        }
+    }
+
+    fn device_lost(&self, _device: OwnedObjectPath) {}
+
+    #[zbus(property, name = "Type")]
+    fn kind(&self) -> String {
+        "or_patterns".to_string()
+    }
+
+    /// (start position, AD type, content): manufacturer specific data that
+    /// starts with Apple's company identifier, little endian.
+    #[zbus(property)]
+    fn patterns(&self) -> Vec<(u8, u8, Vec<u8>)> {
+        vec![(0, 0xff, APPLE.to_le_bytes().to_vec())]
+    }
+}
+
+/// Registers the Apple monitor with the adapter's monitor manager.
+async fn register_monitor(connection: &Connection, adapter: &OwnedObjectPath, senders: Senders) -> Result<()> {
+    let server = connection.object_server();
+    server.at(MONITOR_ROOT, zbus::fdo::ObjectManager).await?;
+    server.at(MONITOR_PATH, AppleMonitor { senders }).await?;
+    let registered = async {
+        AdvertisementMonitorManager1Proxy::builder(connection)
+            .path(adapter.clone())?
+            .build()
+            .await?
+            .register_monitor(&ObjectPath::try_from(MONITOR_ROOT)?)
+            .await
+            .context("register the Bluetooth advertisement monitor")
+    }
+    .await;
+    if registered.is_err() {
+        remove_monitor_objects(connection).await;
+    }
+    registered
+}
+
+async fn remove_monitor_objects(connection: &Connection) {
+    let server = connection.object_server();
+    let _ = server.remove::<AppleMonitor, _>(MONITOR_PATH).await;
+    let _ = server.remove::<zbus::fdo::ObjectManager, _>(MONITOR_ROOT).await;
+}

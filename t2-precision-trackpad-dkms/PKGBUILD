# t2_precision_trackpad: KaiT2en's driver for the T2 MacBook internal
# trackpads (multitouch, firmware geometry, Force Touch/Click), DKMS.
#
# linux-t2 drives these trackpads with a patched hid_magicmouse; stock
# kernels (linux-omarchy) don't know them, so hid-apple takes the trackpad's
# mouse interface as a plain mouse: no two-finger scroll, no tap to click.
# This driver claims only that interface (HID_TYPE_USBMOUSE), so hid-apple
# keeps the keyboard. It must register before the T2 bus enumerates the
# device: list it ahead of t2bce_vhci in the initramfs MODULES.
#
# Upstream: https://github.com/kaiT2en/KaiT2en-Fedora  modules/t2_precision_trackpad
# Its optional haptics partner, t2_trackpad_actuator, is weak-linked:
# t2-trackpad-actuator-dkms.

pkgname=t2-precision-trackpad-dkms
_modname=t2_precision_trackpad
_modver=0.01
pkgver=0.01.r4.27fd5c9
pkgrel=1
pkgdesc="Apple T2 MacBook internal trackpad driver (multitouch, Force Touch) from KaiT2en, DKMS"
arch=('any')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-2.0-only')
depends=('dkms')
makedepends=('git')
# KAIT2EN_GIT=file:///path/to/clone builds from a local KaiT2en checkout.
_repo="${KAIT2EN_GIT:-https://github.com/kaiT2en/KaiT2en-Fedora.git}"
_commit=27fd5c963497556ffc9986779627a0d0f345fbe0
source=("kait2en::git+${_repo}#commit=${_commit}")
sha256sums=('SKIP')

pkgver() {
  cd kait2en
  printf '%s.r%s.%s' "$_modver" \
    "$(git rev-list --count HEAD -- modules/t2_precision_trackpad)" \
    "$(git rev-parse --short=7 HEAD)"
}

package() {
  cd kait2en/modules/t2_precision_trackpad
  local dst="$pkgdir/usr/src/$_modname-$_modver"
  install -Dm644 dkms.conf Makefile t2_precision_trackpad.c hid-ids.h -t "$dst/"
  printf '\n# t2-arch-packages: stock Omarchy kernels only (linux-t2 has its own trackpad driver)\nBUILD_EXCLUSIVE_KERNEL="%s"\n' \
    "${T2_DKMS_KERNEL_REGEX:-.*-omarchy\$}" >> "$dst/dkms.conf"
}

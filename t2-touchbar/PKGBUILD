# T2 Touch Bar: KaiT2en's Touch Bar daemon (from tiny-dfr), drawing its own bar
# on the Touch Bar's screen: dark until touched or Fn, media and F-key layers,
# multi-finger swipes for volume and brightness, four custom keys
# (~/.config/t2-touchbar/keys.toml), haptics through t2_trackpad_actuator, and
# a touch-to-unlock prompt while Touch ID waits (t2-touchid's D-Bus signal).
#
# Upstream: https://github.com/kaiT2en/KaiT2en-Fedora  apps/t2-touchbar.
# Authors: André Eikmeyer and contributors. GPL-3.0-or-later with a section
# 7(b) attribution term (LICENSING.md); tiny-dfr's MIT notice in
# THIRD-PARTY-NOTICES.md. Both ship in /usr/share/licenses.
#
# How it runs: Apple's firmware row (configuration 1 of 05ac:8302, Esc and
# the media keys) stays until a member of the group t2-touchbar starts a
# graphical session, so the console and the unlock prompt keep it (KaiT2en's
# b0acfa7, 2026-11-18). That session's user service (t2-touchbar.service,
# graphical-session) pulls in t2-touchbar-panel.service, which starts the root
# t2-touchbar-session@<UID>.service (allowed by a polkit rule, for exactly that
# unit): it switches the Touch Bar to configuration 2, where t2bdrm drives its
# screen and its digitizer appears, and switches it back when the session
# ends. The root oneshot t2-touchbar-attach.service (wanted by a udev rule when
# the bar appears in configuration 1, after a resume) switches it again while
# such a session runs. A udev
# rule puts that DRM card and digitizer on a private seat (seat-touchbar) so
# the compositor leaves them alone, and gives the group t2-touchbar the
# internal keyboard's event node (for Fn), /dev/uinput (its virtual keys), the
# Touch Bar backlight and the actuator's `play` parameter. The attach service
# also requires the user service enabled globally (`systemctl --global enable
# t2-touchbar.service`), so with it disabled the firmware row stays;
# `t2-touchbar --detach` goes back now.
# Needs t2-touchbar-dkms switched over (t2bdrm, t2touchbar_kbd/_bl).
#
# Changes from upstream (KaiT2en's trademark terms don't allow its name in
# redistributions): binary, units, udev rule, group, /etc/t2-touchbar,
# ~/.config/t2-touchbar, T2_TOUCHBAR_* variables and log prefixes renamed; the
# Touch ID D-Bus name is t2.TouchId, path /t2/TouchId (t2-touchid >= 0.1.0.r14-6
# owns it; before, io.github.josemiguelo.T2TouchId). Font paths are Arch's (adwaita-fonts first).

pkgname=t2-touchbar
_ver=0.1.0
pkgver=0.1.0.r40.b0acfa7
pkgrel=1
pkgdesc="Touch Bar daemon for Apple T2 MacBooks (KaiT2en's, from tiny-dfr)"
arch=('x86_64')
url="https://github.com/kaiT2en/KaiT2en-Fedora"
license=('GPL-3.0-or-later' 'MIT')
depends=('libinput' 'systemd-libs' 'adwaita-fonts' 't2-touchbar-dkms')
optdepends=('t2-trackpad-actuator-dkms: haptic feedback on key presses'
            't2-touchid: the touch-to-unlock prompt while Touch ID waits')
# The D-Bus name changed with t2-touchid 0.1.0.r14-6: an older daemon signals
# on the old one, and the prompt would never show.
conflicts=('t2-touchid<0.1.0.r14.c9e24f7-6')
makedepends=('git' 'cargo')
backup=('etc/t2-touchbar/touchbar.toml')
options=('!debug')
# KAIT2EN_GIT=file:///path/to/clone builds from a local KaiT2en checkout.
_repo="${KAIT2EN_GIT:-https://github.com/kaiT2en/KaiT2en-Fedora.git}"
_commit=b0acfa7c0abe203d45152d61e190165278b39c1e
source=("kait2en::git+${_repo}#commit=${_commit}")
sha256sums=('SKIP')

pkgver() {
  cd kait2en
  printf '%s.r%s.%s' "$_ver" \
    "$(git rev-list --count HEAD -- apps/t2-touchbar)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd kait2en/apps/t2-touchbar
  sed -i 's/^name = "kait2en-touchbar"$/name = "t2-touchbar"/' Cargo.toml Cargo.lock
  sed -i \
    -e 's|org\.kait2en\.TouchId|t2.TouchId|g' \
    -e 's|/org/kait2en/TouchId|/t2/TouchId|g' \
    -e 's|/etc/kait2en/touchbar\.toml|/etc/t2-touchbar/touchbar.toml|g' \
    -e 's|KAIT2EN_TOUCHBAR_|T2_TOUCHBAR_|g' \
    -e 's|kait2en-keys-|t2-touchbar-keys-|g' \
    -e 's|kait2en-touchbar|t2-touchbar|g' \
    -e 's|/usr/share/fonts/adwaita-sans-fonts/AdwaitaSans-Regular\.ttf|/usr/share/fonts/Adwaita/AdwaitaSans-Regular.ttf|' \
    -e 's|/usr/share/fonts/rsms-inter-vf-fonts/InterVariable\.ttf|/usr/share/fonts/inter/InterVariable.ttf|' \
    -e 's|/usr/share/fonts/abattis-cantarell-vf-fonts/Cantarell-VF\.otf|/usr/share/fonts/cantarell/Cantarell-VF.otf|' \
    src/*.rs
  sed -i 's|/etc/kait2en/kbd-backlight\.toml|/etc/t2-kbd-backlight/kbd-backlight.toml|' config/touchbar.toml
  if grep -rni 'kait2en' src config Cargo.toml; then
    echo "a KaiT2en name is left in the sources" >&2
    return 1
  fi
  grep -q '/usr/share/fonts/Adwaita/AdwaitaSans-Regular.ttf' src/renderer.rs ||
    { echo "font paths not patched" >&2; return 1; }
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd kait2en/apps/t2-touchbar
  export CARGO_TARGET_DIR=target
  cargo build --release --frozen
}

package() {
  cd kait2en
  local app=apps/t2-touchbar
  install -Dm755 "$app/target/release/t2-touchbar" "$pkgdir/usr/bin/t2-touchbar"

  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/t2-touchbar.service" <<'EOF'
[Unit]
Description=T2 Touch Bar
After=graphical-session.target
PartOf=graphical-session.target
# Users outside the group keep Apple's firmware row.
ConditionGroup=t2-touchbar
# The panel unit switches the bar to the display first and back once the
# daemon is gone (outside this sandbox, which allows one process per unit).
Requires=t2-touchbar-panel.service
After=t2-touchbar-panel.service
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/t2-touchbar
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
PrivateTmp=true
PrivateIPC=true
ProtectKernelTunables=true
ReadWritePaths=-/sys/class/backlight/t2tb_backlight/brightness
ReadWritePaths=-/sys/class/backlight/appletb_backlight/brightness
ReadWritePaths=-/sys/module/t2_trackpad_actuator/parameters/play
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictSUIDSGID=true

[Install]
WantedBy=graphical-session.target
EOF

  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/t2-touchbar-panel.service" <<'EOF'
[Unit]
Description=T2 Touch Bar display for this session
ConditionGroup=t2-touchbar
StopWhenUnneeded=yes

[Service]
Type=oneshot
RemainAfterExit=yes
# The bar to the display for this session, and back to Apple's row when it
# ends; the polkit rule allows exactly this system unit.
ExecStart=/usr/bin/systemctl start --no-ask-password t2-touchbar-session@%U.service
ExecStop=/usr/bin/systemctl stop --no-ask-password t2-touchbar-session@%U.service
TimeoutStartSec=90
EOF

  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/t2-touchbar-session@.service" <<'EOF'
[Unit]
Description=Switch the Apple T2 Touch Bar to the display for user %i
# The instance is the UID: it runs only alongside that user's manager and
# stops with it, so a logout always hands the bar back to Apple's row.
Requisite=user@%i.service
After=user@%i.service
PartOf=user@%i.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/t2-touchbar --attach
ExecStop=/usr/bin/t2-touchbar --detach
TimeoutStartSec=60
EOF

  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/t2-touchbar-attach.service" <<'EOF'
[Unit]
Description=Attach the Apple T2 Touch Bar display interface

[Service]
Type=oneshot
# Started by udev when the bar comes up on Apple's row (at boot, after a
# resume). It switches only while a graphical session of a t2-touchbar member
# runs the daemon, so the console and the unlock prompt keep the native row.
ExecCondition=/usr/bin/systemctl --global is-enabled --quiet t2-touchbar.service
ExecCondition=/usr/bin/systemctl is-active --quiet t2-touchbar-session@*.service
ExecStart=/usr/bin/t2-touchbar --attach
TimeoutStartSec=60
Restart=on-failure
RestartSec=5
EOF

  install -Dm644 /dev/stdin "$pkgdir/usr/share/polkit-1/rules.d/50-t2-touchbar.rules" <<'EOF'
// Members of t2-touchbar may start and stop the root unit that switches the
// Touch Bar between Apple's row and the display; their user service does that
// when the graphical session starts and ends.
polkit.addRule(function(action, subject) {
	if (action.id != "org.freedesktop.systemd1.manage-units" ||
	    !subject.isInGroup("t2-touchbar"))
		return polkit.Result.NOT_HANDLED;
	var unit = action.lookup("unit");
	var verb = action.lookup("verb");
	if (/^t2-touchbar-session@[0-9]+\.service$/.test(unit) &&
	    (verb == "start" || verb == "stop"))
		return polkit.Result.YES;
	return polkit.Result.NOT_HANDLED;
});
EOF

  install -Dm644 /dev/stdin "$pkgdir/usr/lib/udev/rules.d/99-zz-t2-touchbar.rules" <<'EOF'
# t2-touchbar. The Touch Bar's screen (t2bdrm) and digitizer go on a private
# seat the compositor leaves alone; the daemon opens them directly.
SUBSYSTEM=="drm", KERNEL=="card*", DRIVERS=="t2bdrm|appletbdrm|adp", TAG-="master-of-seat", ENV{ID_SEAT}="seat-touchbar", GROUP="t2-touchbar", MODE="0660"
SUBSYSTEM=="input", ATTR{name}=="Apple Inc. Touch Bar Display Touchpad", ENV{SYSTEMD_WANTS}="", ENV{ID_SEAT}="seat-touchbar", GROUP="t2-touchbar", MODE="0660"
SUBSYSTEM=="input", ATTR{name}=="Apple Inc. Touch Bar Display", ENV{SYSTEMD_WANTS}="", ENV{ID_SEAT}="seat-touchbar", GROUP="t2-touchbar", MODE="0660"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Apple Inc. Touch Bar Display Touchpad", ENV{ID_SEAT}="seat-touchbar", GROUP="t2-touchbar", MODE="0660"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Apple Inc. Touch Bar Display", ENV{ID_SEAT}="seat-touchbar", GROUP="t2-touchbar", MODE="0660"

# The backlight controller (05ac:8102) may autosuspend; never the display and
# touch device (05ac:8302), whose digitizer wakes the bar.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ATTR{idProduct}=="8102", TEST=="power/autosuspend_delay_ms", ATTR{power/autosuspend_delay_ms}="1000"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ATTR{idProduct}=="8102", TEST=="power/control", ATTR{power/control}="auto"

# Fn comes from the internal keyboard: its event node, for the group only.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="*Apple Internal Keyboard / Trackpad", GROUP="t2-touchbar", MODE="0660"

# Configuration 1 is the firmware key row; 2 exposes the DRM display and the
# digitizer. The root oneshot switches it while a session runs the daemon.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="05ac", ATTR{idProduct}=="8302", ATTR{power/control}="on", ATTR{power/autosuspend_delay_ms}="-1"
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="05ac", ATTR{idProduct}=="8302", ATTR{bConfigurationValue}=="1", TAG+="systemd", ENV{SYSTEMD_WANTS}+="t2-touchbar-attach.service"

# The group may set the Touch Bar's light and send its whitelisted virtual keys.
ACTION=="add|change", SUBSYSTEM=="backlight", KERNEL=="t2tb_backlight", RUN+="/usr/bin/chgrp t2-touchbar /sys/class/backlight/%k/brightness", RUN+="/usr/bin/chmod g+w /sys/class/backlight/%k/brightness"
ACTION=="add|change", SUBSYSTEM=="backlight", KERNEL=="appletb_backlight", RUN+="/usr/bin/chgrp t2-touchbar /sys/class/backlight/%k/brightness", RUN+="/usr/bin/chmod g+w /sys/class/backlight/%k/brightness"
SUBSYSTEM=="misc", KERNEL=="uinput", GROUP="t2-touchbar", MODE="0660"

# The actuator parameter accepts only the captured light/firm presets.
ACTION=="add|change", SUBSYSTEM=="hid", DRIVERS=="t2_trackpad_actuator", RUN+="/usr/bin/chgrp t2-touchbar /sys/module/t2_trackpad_actuator/parameters/play", RUN+="/usr/bin/chmod g+w /sys/module/t2_trackpad_actuator/parameters/play"
EOF

  install -Dm644 /dev/stdin "$pkgdir/usr/lib/sysusers.d/t2-touchbar.conf" <<'EOF'
g t2-touchbar - -
EOF

  install -Dm644 "$app/config/touchbar.toml" "$pkgdir/etc/t2-touchbar/touchbar.toml"
  install -Dm644 "$app/THIRD-PARTY-NOTICES.md" LICENSING.md AUTHORS LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}

#!/bin/bash
# t2-omarchy-setup: the T2 packages' Omarchy bar plugins and menu entries, for
# the user who runs it (Omarchy loads third-party plugins and menu extensions
# only from ~/.config/omarchy, which a package can't write to).
#
#   t2-omarchy-setup          link, place on the bar, write the menu entries
#   t2-omarchy-setup --check  exit 0 when everything is in place, 1 when not
#
# - Plugins: every /usr/share/t2-omarchy/plugins/<id> (shipped by t2-truetone,
#   t2-airshare, t2-sidecar, ...) is linked as ~/.config/omarchy/plugins/<id>,
#   so package updates reach it; a folder of the same name (a copy from before)
#   is moved to ~/.local/state/t2-omarchy/replaced. Links to a removed
#   package's plugin are taken away.
# - Bar: each is put before Bluetooth, in the order of
#   /usr/share/t2-omarchy/order (then any other), through `omarchy-bar put`,
#   which leaves a widget already on the bar where it is. Needs the shell
#   running: Omarchy's first login runs this (the fork's
#   install/user/first-run/t2-omarchy.sh).
# - Menu: every /usr/share/t2-omarchy/menu/<name>.jsonc is kept as a marked
#   block in ~/.config/omarchy/extensions/omarchy-menu.jsonc; a block from a
#   package no longer installed is taken out.
set -euo pipefail

SHARE=/usr/share/t2-omarchy
CFG=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy
PLUGINS=$CFG/plugins
MENU=$CFG/extensions/omarchy-menu.jsonc
REPLACED=${XDG_STATE_HOME:-$HOME/.local/state}/t2-omarchy/replaced
check=0
[[ ${1:-} == --check ]] && check=1
[[ ${1:-} == "" || $check == 1 ]] || { sed -n '2,/^set -euo/p' "$0" | sed '$d;s/^# \{0,1\}//' >&2; exit 2; }

ids=()
for dir in "$SHARE"/plugins/*/; do
  [[ -f $dir/manifest.json ]] && ids+=("$(basename "$dir")")
done
# The order file first, then any plugin it doesn't name.
ordered=()
while read -r id; do
  [[ -n $id && $id != \#* && -f $SHARE/plugins/$id/manifest.json ]] && ordered+=("$id")
done < <(cat "$SHARE/order" 2>/dev/null)
for id in "${ids[@]}"; do [[ " ${ordered[*]} " == *" $id "* ]] || ordered+=("$id"); done

# The menu blocks, by python: the menu file is JSONC, edited as lines.
menu() { # check|write
  python3 - "$1" "$MENU" "$SHARE/menu" <<'PY'
import os, re, sys
from pathlib import Path
mode, menu, src = sys.argv[1], Path(sys.argv[2]), Path(sys.argv[3])
BEGIN, END = "  // >>> Managed by t2-omarchy-setup ({})", "  // <<< Managed by t2-omarchy-setup ({})"
OURS = re.compile(r"^  // >>> Managed by t2-omarchy-setup \((.+)\)$")
# Blocks the owner's dotfiles wrote before the packages took them over: taken out.
LEGACY = ["t2-airshare-menu"]
want = {}
for f in (sorted(src.glob("*.jsonc")) if src.is_dir() else []):
    body = f.read_text().rstrip("\n").split("\n")
    want[f.stem] = [BEGIN.format(f.stem), f"  // {f.stem}'s entries, from {f} (rewritten by t2-omarchy-setup).", *body, END.format(f.stem)]
lines = menu.read_text().rstrip("\n").split("\n") if menu.exists() else ["{", "}"]
blocks, rest, cur, end = {}, [], None, None
for line in lines:
    if cur is None:
        m = OURS.match(line)
        if m:
            cur, end = m.group(1), END.format(m.group(1))
        else:
            for name in LEGACY:
                if line == f"  // >>> Managed by loadout ({name})":
                    cur, end = "legacy:" + name, f"  // <<< Managed by loadout ({name})"
    if cur is None:
        rest.append(line)
        continue
    blocks.setdefault(cur, []).append(line)
    if line == end:
        cur = None
ok = set(blocks) == set(want) and all(blocks[k] == want[k] for k in want)
if mode == "check":
    sys.exit(0 if ok else 1)
if ok:
    sys.exit(0)
brace = next(i for i, l in enumerate(rest) if l.lstrip().startswith("{"))
new = rest[: brace + 1] + [l for k in want for l in want[k]] + rest[brace + 1 :]
menu.parent.mkdir(parents=True, exist_ok=True)
tmp = menu.with_suffix(".jsonc.tmp")
tmp.write_text("\n".join(new) + "\n")
os.replace(tmp, menu)
PY
}

if (( check )); then
  for id in "${ids[@]}"; do
    [[ $(readlink "$PLUGINS/$id" 2>/dev/null) == "$SHARE/plugins/$id" ]] || exit 1
    jq -e --arg id "$id" '[.bar.layout[]?[]? | if type == "object" then .id else . end] | index($id)' "$CFG/shell.json" >/dev/null 2>&1 || exit 1
  done
  menu check
  exit
fi

mkdir -p "$PLUGINS"
for id in "${ids[@]}"; do
  link=$PLUGINS/$id
  if [[ -e $link && ! -L $link ]]; then
    mkdir -p "$REPLACED"
    mv "$link" "$REPLACED/$id.$(date +%Y%m%d-%H%M%S)"
    echo "t2-omarchy-setup: moved the old copy of $id to $REPLACED"
  fi
  [[ $(readlink "$link" 2>/dev/null) == "$SHARE/plugins/$id" ]] || ln -sfn "$SHARE/plugins/$id" "$link"
done
# Links to plugins whose package is gone (or to where t2-sidecar 0.2 kept its).
for link in "$PLUGINS"/*; do
  [[ -L $link ]] || continue
  target=$(readlink "$link")
  [[ $target == "$SHARE"/plugins/* || $target == /usr/share/t2-sidecar/omarchy-plugin ]] || continue
  [[ -e $link/manifest.json && $target == "$SHARE"/* ]] || { rm -f "$link"; echo "t2-omarchy-setup: removed $link"; }
done

menu write

omarchy-shell -q shell rescanPlugins || true
for id in "${ordered[@]}"; do
  omarchy-bar put "$id" --before omarchy.bluetooth >/dev/null 2>&1 ||
    omarchy-bar put "$id" --section right >/dev/null 2>&1 ||
    echo "t2-omarchy-setup: couldn't put $id on the bar (is the shell running?)" >&2
done
echo "t2-omarchy-setup: ${ordered[*]:-no plugins} in place"

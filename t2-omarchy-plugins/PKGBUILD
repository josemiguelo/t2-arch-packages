# t2-omarchy-plugins: the T2 panel on Omarchy's bar (t2.panel), a tab
# for each T2 feature whose package is installed, and t2-omarchy-setup, which
# gives the user the panel and the packages' menu entries. Omarchy loads third-party plugins and
# menu extensions only from ~/.config/omarchy, which a package can't write to,
# so the panel lives under /usr/share/t2-omarchy/plugins/t2.panel, each
# T2 package ships its tab under /usr/share/t2-omarchy/tabs/<id>/ (Tab.qml,
# tab.json: title, icon, order, an indicator unit) and its menu entries under
# /usr/share/t2-omarchy/menu/<name>.jsonc, and t2-omarchy-setup links the panel
# into ~/.config/omarchy/plugins (package updates then reach it), puts it on
# the bar, keeps the menu entries as marked blocks, and retires the separate
# widgets of 0.1. The bar icon carries a dot while AirShare is visible or
# Sidecar streams. The Omarchy fork's first login runs it; on
# a Mac installed before, run it once (and after a package adds a plugin).
#
# Ours (t2-arch-packages).

pkgname=t2-omarchy-plugins
pkgver=0.4
pkgrel=1
pkgdesc="The T2 panel on Omarchy's bar (a tab per T2 feature) and its per-user setup"
arch=('any')
url="https://github.com/josemiguelo/t2-arch-packages"
license=('GPL-3.0-or-later')
depends=('bash' 'jq' 'python')
source=('t2-omarchy-setup')
sha256sums=('SKIP')

package() {
  install -Dm755 t2-omarchy-setup "$pkgdir/usr/bin/t2-omarchy-setup"
  local hub="$startdir/hub" dest="$pkgdir/usr/share/t2-omarchy/plugins/t2.panel"
  install -Dm644 "$hub/manifest.json" "$hub/Panel.qml" -t "$dest/"
  install -Dm755 "$hub/t2hub" "$dest/t2hub"
  install -dm755 "$pkgdir/usr/share/t2-omarchy/tabs" "$pkgdir/usr/share/t2-omarchy/menu"
}

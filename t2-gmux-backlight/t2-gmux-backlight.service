[Unit]
Description=Keep the gmux panel backlight at its level after the panel powers up
# No ConditionPathExists: the device can register after this starts; the
# watcher waits for it.

[Service]
ExecStart=/usr/bin/t2-gmux-backlight watch
Restart=on-failure
StateDirectory=t2-gmux-backlight

[Install]
WantedBy=multi-user.target
